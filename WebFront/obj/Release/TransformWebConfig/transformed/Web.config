  https://go.microsoft.com/fwlink/?LinkId=301880
  -->
<configuration>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="version" value="" />
    <add key="EmisorMail" value="servicios@botiseller.com" />
    <add key="WebApiUrlCRM" value="http://localhost:44310" />
    <add key="WebApiUrlCampaigne" value="http://localhost:44210" />
    <add key="WebApiUrlIA" value="http://localhost:50110" />
    <add key="WebApiUrlChat" value="http://localhost:47310" />
    <add key="WebApiUrlReporting" value="http://localhost:44330" />
    <add key="WebApiUrlCampaignPublic" value="http://localhost:62670" />
    <add key="WebApiUrlIntegration" value="http://localhost:45310" />
    <add key="WebUrlCampaignPublic" value="https://public.campaign.botiseller.com" />
  </appSettings>
  <!--
    Para obtener una descripción de los cambios de web.config, vea http://go.microsoft.com/fwlink/?LinkId=235367.

    Los siguientes atributos se pueden establecer en la etiqueta <httpRuntime>.
      <system.Web>
        <httpRuntime targetFramework="4.8" />
      </system.Web>
  -->
  <system.web>
    <globalization culture="es-ES" />
    <compilation targetFramework="4.8" />
    <httpRuntime targetFramework="4.6.1" />
    <authentication mode="Forms">
      <forms name="Amplitone" path="/" defaultUrl="/Inicio/Inicio" loginUrl="/Authentication/Authentication" protection="All" timeout="525600" />
    </authentication>
    <authorization>
      <deny users="?" />
    </authorization>
  </system.web>
  <!--Acceso permitido para todos los no logueados-->
  <location path="Authentication">
    <system.web>
      <authorization>
        <allow users="?" />
      </authorization>
    </system.web>
  </location>
  <location path="Error">
    <system.web>
      <authorization>
        <allow users="?" />
      </authorization>
    </system.web>
  </location>
  <location path="javascripts">
    <system.web>
      <authorization>
        <allow users="?" />
      </authorization>
    </system.web>
  </location>
  <location path="estilo">
    <system.web>
      <authorization>
        <allow users="?" />
      </authorization>
    </system.web>
  </location>
  <!-- Fin -->
