@using System.Web.Optimization




<div class="">

    <!-- Basic data -->
    <div class="card basic" style="display: flex;">

        <div class="card intro">
            <div class="intro-icon"><i class="fas fa-users fa-lightbulb"></i></div>
            <div>
                <h2>Segmentación</h2>
                <p>
                    Define a quién enviar tus campañas automáticamente segmentando a tus contactos según
                    los datos de tu cartera de clientes.
                </p>

                <ul class="bullets">
                    <li><i class="fa-check-circle fas"></i> Puedes crear segmentos dinámicos que se actualizan solos.</li>
                    <li><i class="fa-check-circle fas"></i> Combina distintas reglas para lograr mayor precisión.</li>
                </ul>
            </div>
        </div>

        <div class="basic-grid w-100 ml-4 mt-3">

            <div>
                <div class="" style="margin-bottom:12px;">
                    <label class="form-label" for="txtNombre">Nombre <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="txtNombre" placeholder="Nombre" data-bind="value: nombre" required="required" maxlength="100">
                    <div class="invalid-feedback">Campo obligatorio.</div>
                    <div class="valid-feedback">
                        Correcto!
                    </div>
                </div>

                <div class="">
                    <label class="form-label" for="txtDescripción">Descripción</label>
                    <textarea id="txtDescripción" class="form-control" placeholder="Descripción" maxlength="2000" rows="4" data-bind="value: descripcion" style="resize:unset;"></textarea>
                </div>
            </div>

            <div class="toggles">
                <div class="toggle-row">
                    <label class="form-label" for="swtIncluyeLead">Incluye lead</label>
                    <div class="custom-control custom-switch AligneCenter">
                        <input type="checkbox" class="custom-control-input" id="swtIncluyeLead" checked="" data-bind="checked: incluyeLead">
                        <label class="custom-control-label cursor-pointer" for="swtIncluyeLead"></label>
                    </div>
                </div>

                <div class="toggle-row">
                    <label class="form-label" for="swtIncluyeContacto">Incluye contacto</label>
                    <div class="custom-control custom-switch AligneCenter">
                        <input type="checkbox" class="custom-control-input" id="swtIncluyeContacto" checked="" data-bind="checked: incluyeContacto">
                        <label class="custom-control-label cursor-pointer" for="swtIncluyeContacto"></label>
                    </div>
                </div>
            </div>

        </div>


    </div>

    <!-- Rules -->
    <div class="card rules form-row">
        <div class="rules-head col-12">
            <h3 class="rules-title">
                <span class="badge"><i class="fas fa-sliders-h"></i></span>
                Reglas de segmentación
            </h3>

        </div>

        <div class="tiles">

            <div class="tile">
                <div class="tile-head">
                    <div class="tile-ico"><i class="fas fa-filter"></i></div>
                    Estado
                </div>
                <p>Añade una regla según el estado de tus contactos.</p>
                <div class="control row">

                    <div class="col-12 AligneCenter">
                        <div class="dropdown">
                            <a class="nav-link dropdown-toggle fs-xl text-truncate text-info pl-0" href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <span>Estados</span>
                                <!-- ko if: Enumerable.From(estadosList()).Where(function (x) { return x.Check(); }).FirstOrDefault() != undefined -->
                                <span class="badge badge-pill badge-danger has-tooltip" title="Cantidad de Elemtnos Filtrados" style="position:absolute;top:-4px;font-size:9px;margin-left:10px;" data-bind="text: Enumerable.From(estadosList()).Where(function (x) { return x.Check(); }).ToArray().length"></span>
                                <!-- /ko -->
                            </a>
                            <div class="dropdown-menu fadeindown" data-bind="foreach: estadosList()" style=" min-width: 300px; border-radius: 5px;">
                                <div class="dropdown-item">
                                    <div class="custom-control custom-checkbox">
                                        <input type="checkbox" class="custom-control-input" data-bind="checked: Check, attr: { id: EstadoLeadId() }">
                                        <label class="custom-control-label cursor-pointer" data-bind="text:Nombre(),attr: { for: EstadoLeadId() }"></label>
                                    </div>
                                </div>
                                <span class="chevron"></span>
                            </div>
                        </div>
                    </div>


                </div>
            </div>

            <div class="tile">
                <div class="tile-head">
                    <div class="tile-ico"><i class="fas fa-filter"></i></div>
                    Grupo
                </div>
                <p>Añade una regla según el grupo de tus contactos.</p>
                <div class="control row">
                    <div class="col-12 AligneCenter">
                        <div class="dropdown">
                            <a class="nav-link dropdown-toggle fs-xl text-truncate text-info pl-0" href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <span>Grupo</span>
                                <!-- ko if: Enumerable.From(grupoList()).Where(function (x) { return x.Check(); }).FirstOrDefault() != undefined -->
                                <span class="badge badge-pill badge-danger has-tooltip" title="Cantidad de Elemtnos Filtrados" style="position:absolute;top:-4px;font-size:9px;margin-left:10px;" data-bind="text: Enumerable.From(grupoList()).Where(function (x) { return x.Check(); }).ToArray().length"></span>
                                <!-- /ko -->
                            </a>
                            <div class="dropdown-menu fadeindown" data-bind="foreach: grupoList()" style=" min-width: 300px; border-radius: 5px;">
                                <div class="dropdown-item">
                                    <div class="custom-control custom-checkbox">
                                        <input type="checkbox" class="custom-control-input" data-bind="checked: Check, attr: { id: GrupoLeadId() }">
                                        <label class="custom-control-label cursor-pointer" data-bind="text:Nombre(),attr: { for: GrupoLeadId() }"></label>
                                    </div>
                                </div>
                                <span class="chevron"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ko foreach: { data: datosAdicionalesList, as: 'datoAdicional' }-->
            <!-- ko if: (datoAdicional.Tipo() == new Enums().TipoDatoAdicional.entero || datoAdicional.Tipo() == new Enums().TipoDatoAdicional.fecha || datoAdicional.Tipo() == new Enums().TipoDatoAdicional.numericoDecimal || datoAdicional.Tipo() == new Enums().TipoDatoAdicional.lista || datoAdicional.Tipo() == new Enums().TipoDatoAdicional.listaMultipleSelect)-->
            <div class="tile">
                <div class="tile-head">
                    <div class="tile-ico"><i class="fas fa-filter"></i></div>
                    <span data-bind="html: datoAdicional.Nombre()"></span>

                </div>
                <p data-bind="html: 'Añade una regla con base en tus ' + datoAdicional.Nombre().toLowerCase()"></p>
                <div class="control row">
                    <div class="col-12 AligneCenter">
                        <!-- ko if: (datoAdicional.Tipo() == new Enums().TipoDatoAdicional.entero)-->
                        <label class="form-label" data-bind="html: datoAdicional.Nombre()"></label>
                        <div class="row">
                            <div class="input-group col">
                                <input type="text" class="form-control" data-inputmask="'alias': 'integer'" im-insert="true" placeholder="Desde" data-bind="value: datoAdicional.ValorCantidadDesde,event:{ change: datoAdicional.changeCantidad}" />
                            </div>
                            <div class="input-group col">
                                <input type="text" class="form-control" data-inputmask="'alias': 'integer'" im-insert="true" placeholder="Hasta" data-bind="value: datoAdicional.ValorCantidadHasta,event:{ change: datoAdicional.changeCantidad}" />
                            </div>
                        </div>
                        <!--/ko-->
                        <!--ko if: (datoAdicional.Tipo() == new Enums().TipoDatoAdicional.fecha)-->
                        <label class="form-label" data-bind="html: datoAdicional.Nombre()"></label>
                        <div class="input-daterange row divRangoFechaCreacion m-0">
                            <div class="input-group col pl-0">
                                <input type="text" class="form-control datepicker-bottom-left" placeholder="Fecha Desde" autocomplete="off" name="start" data-bind="value: datoAdicional.ValorFechaDesde">
                                <div class="input-group-sm input-group-append">
                                    <span class="input-group-text fs-xl">
                                        <i class="fal fa-calendar-alt"></i>
                                    </span>
                                </div>
                            </div>
                            <div class="input-group col pr-0">
                                <input type="text" class="form-control datepicker-bottom-left" placeholder="Fecha Hasta" autocomplete="off" name="end" data-bind="value: datoAdicional.ValorFechaHasta">
                                <div class="input-group-sm input-group-append">
                                    <span class="input-group-text fs-xl">
                                        <i class="fal fa-calendar-alt"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <!--/ko-->
                        <!--ko if: (datoAdicional.Tipo() == new Enums().TipoDatoAdicional.numericoDecimal)-->
                        <label class="form-label" data-bind="html: datoAdicional.Nombre()"></label>
                        <div class="row">
                            <div class="input-group col">
                                <input type="text" class="form-control" data-inputmask="'alias': 'decimal'" im-insert="true" placeholder="Desde" data-bind="value: datoAdicional.ValorCantidadDesde,event:{ change: datoAdicional.changeCantidad}" />
                                <div class="input-group-append">
                                    <span class="input-group-text">.00</span>
                                </div>
                            </div>
                            <div class="input-group col">
                                <input type="text" class="form-control" data-inputmask="'alias': 'decimal'" im-insert="true" placeholder="Hasta" data-bind="value: datoAdicional.ValorCantidadHasta,event:{ change: datoAdicional.changeCantidad}" />
                                <div class="input-group-append">
                                    <span class="input-group-text">.00</span>
                                </div>
                            </div>
                        </div>
                        <!--/ko-->
                        <!--ko if: (datoAdicional.Tipo() == new Enums().TipoDatoAdicional.lista || datoAdicional.Tipo() == new Enums().TipoDatoAdicional.listaMultipleSelect)-->
                        <div class="dropdown">
                            <a class="nav-link dropdown-toggle fs-xl text-truncate text-info pl-0" href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <span data-bind="html: datoAdicional.Nombre()"></span>
                                <!--ko if: Enumerable.From(datoAdicional.DatosAdicionalesLista()).Where(function (x) { return x.Check(); }).FirstOrDefault() != undefined-->
                                <span class="badge badge-pill badge-danger has-tooltip" title="Cantidad de Elemtnos Filtrados" style="position:absolute;top:-4px;font-size:9px;margin-left:10px;" data-bind="text: Enumerable.From(datoAdicional.DatosAdicionalesLista()).Where(function (x) { return x.Check(); }).ToArray().length"></span>
                                <!--/ko-->
                            </a>
                            <div class="dropdown-menu fadeindown" data-bind="foreach: datoAdicional.DatosAdicionalesLista()" style=" min-width: 300px; border-radius: 5px;">
                                <div class="dropdown-item">
                                    <div class="custom-control custom-checkbox">
                                        <input type="checkbox" class="custom-control-input" data-bind="checked: Check, attr: { id: DatoAdicionalListaId() }">
                                        <label class="custom-control-label cursor-pointer" data-bind="text:Valor(),attr: { for: DatoAdicionalListaId() }"></label>
                                    </div>
                                </div>
                                <span class="chevron"></span>
                            </div>
                        </div>
                        <!--/ko-->
                    </div>


                </div>
            </div>
            <!--/ko-->
            <!--/ko-->



        </div>
    </div>

</div>




