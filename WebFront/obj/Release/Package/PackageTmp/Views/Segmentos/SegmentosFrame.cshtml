<style>
    /* Card container */
    .boti-seg-card {
        background: #ffffff;
        border: 1px solid rgba(120, 80, 190, .18);
        border-radius: 16px;
        padding: 16px 16px 14px;
        box-shadow: 0 10px 24px rgba(20, 16, 40, .06);
        transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
        position: relative;
        overflow: hidden;
        height: 195px;
    }

        .boti-seg-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 34px rgba(20, 16, 40, .10);
            border-color: rgba(120, 80, 190, .28);
        }

    /* Header */
    .boti-seg-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
    }

    .boti-seg-title {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        min-width: 0;
    }

    .boti-seg-icon {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(111,75,216,.10);
        color: #6f4bd8;
        flex: 0 0 auto;
        font-size: 18px;
    }

    .boti-seg-titletext {
        min-width: 0;
    }

    .boti-seg-name {
        font-size: 16px;
        font-weight: 700;
        color: #1f1d2b;
        line-height: 1.2;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .boti-seg-desc {
        font-size: 12.5px;
        color: #6b6a77;
        margin-top: 2px;
        line-height: 1.35;
        max-height: 34px;
        overflow: hidden;
    }

    /* Actions */
    .boti-seg-actions {
        flex: 0 0 auto;
    }

    .boti-icon-btn {
        width: 36px;
        height: 36px;
        border-radius: 12px;
        border: 1px solid rgba(120, 80, 190, .18);
        background: #fff;
        color: #6b6a77;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background .15s ease, border-color .15s ease, color .15s ease;
    }

        .boti-icon-btn:hover {
            background: rgba(121, 77, 191, .06);
            border-color: rgba(120, 80, 190, .28);
            color: #5a35c9;
        }

    /* Meta pills */
    .boti-seg-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 12px;
    }

    .boti-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .boti-pill-soft {
        background: rgba(121, 77, 191, .08);
        color: #5130ba;
        border: 1px solid rgba(121, 77, 191, .16);
    }

    .boti-pill i {
        font-size: 12px;
    }

    /* Section */
    .boti-seg-section {
        margin-top: 12px;
    }

    .boti-seg-section-title {
        font-size: 12px;
        font-weight: 700;
        color: #3b3a46;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
    }

    .boti-seg-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    /* Chips */
    .boti-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 10px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
        border: 1px solid rgba(20, 16, 40, .08);
        background: #fbfbfe;
        color: #3b3a46;
    }

    .boti-chip-state {
        background: rgba(0, 197, 168, .06);
        border-color: rgba(0, 197, 168, .18);
    }

    .boti-chip-group {
        background: rgba(121, 77, 191, .06);
        border-color: rgba(121, 77, 191, .18);
        color: #5130ba;
    }

    .boti-dot {
        width: 8px;
        height: 8px;
        border-radius: 99px;
        display: inline-block;
    }

    .boti-dot-green {
        background: #21c38f;
    }

    .boti-dot-amber {
        background: #f0b429;
    }

    .boti-dot-red {
        background: #ef4e4e;
    }

    /* Footer */
    .boti-seg-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .boti-muted {
        font-size: 12px;
        color: #6b6a77;
        font-weight: 600;
    }

    /* Channels */
    .boti-seg-channels {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .boti-chan {
        width: 34px;
        height: 34px;
        border-radius: 12px;
        border: 1px solid rgba(121, 77, 191, .16);
        background: rgba(121, 77, 191, .05);
        color: #5a35c9;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

        .boti-chan i {
            font-size: 16px;
        }

        .boti-chan .boti-chan-sub {
            position: absolute;
            right: 6px;
            bottom: 6px;
            font-size: 9px;
            color: rgba(31, 29, 43, .70);
            background: #fff;
            border-radius: 8px;
            padding: 2px;
            border: 1px solid rgba(20, 16, 40, .08);
        }
</style>


