@using System.Web.Optimization

@{
    Layout = "~/Views/_LoginLayout.cshtml";
}

@section scripts
{
    @Scripts.Render("~/Scripts" + Common.Utility.Helper.getVersionScript() + "/Models/Authentication/Authentication.js")
}

<div id="Login" class="row m-0" style="background-color: #F4F6F9;background-size: cover;height: 100%;">
    <div class="my-auto mx-auto">
        <div class="form-row">
            <div class="col-12 text-center">
                <div class="spinner-border" style="width: 6rem; height: 6rem;" role="status">
                    <span class="sr-only">Loading...</span>
                </div>
            </div>
        </div>
        <div class="form-row">
            <div class="col-12 text-center">
                <h2 class="m-0">
                    Espere un momento...
                </h2>
            </div>
        </div>
    </div>
    <div class="divLoginRedes">
        <a href="https://www.instagram.com/qstomargentina/" target="_blank" style="text-decoration: none !important;">
            <img src="~/Img/login/icon-INS.png" width="40" class="has-tooltip" title="Instagram" />
        </a>

        <a href="https://www.facebook.com/QstomArgentina/" target="_blank" style="text-decoration: none !important;">
            <img src="~/Img/login/icono-FAC.png" width="40" class="has-tooltip" title="Facebook" />
        </a>

        <a href="https://www.linkedin.com/company/qstom/" target="_blank" style="text-decoration: none !important;">
            <img src="~/Img/login/icon-LINK.png" width="40" class="has-tooltip" title="Linkedin" />
        </a>
    </div>
    <span id="versionAssembly" style="display:none;">Version: @Html.ViewContext.HttpContext.ApplicationInstance.GetType().BaseType.Assembly.GetName().Version</span>
</div>


