<div id="SectionSelling">
    <div class="row">
        <div class="col-12">
            <label class="float-right" data-bind="text: 'Ultima actualización: ' + moment().format('hh') + ':' + moment().format('ss') "></label>
        </div>
    </div>
    <nav class="navbar navbar-expand-md navbar-light p-0 mb-3">
        <button class="navbar-toggler mt-1 mb-1" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="true" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-collapse collapse" id="navbarSupportedContent">
            <ul class="navbar-nav mr-auto">
                <li>
                    <input type="text" class="form-control" id="txtFechaFiltroSelling" data-bind="value:fechaFiltro,event:{ change: changeFechaFiltro}">
                </li>
                <li class="nav-item hidden-md-down">
                    <a class="nav-link fs-xl text-truncate text-truncate-lg text-info" style="color: #e0e0e0 !important;">|</a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle fs-xl text-truncate text-truncate-lg text-info" href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        Selling
                    </a>
                    <div class="dropdown-menu fadeindown p-0" data-bind="foreach:sellingList()">
                        <div class="dropdown-item">
                            <div class="custom-control custom-checkbox">
                                <input type="checkbox" class="custom-control-input" data-bind="checked: Check,click: $root.buttonCheck.bind($data, SellingId()), attr: { id: SellingId() },disable:Check() && SellingId() == Guid.Empty + '_Selling'">
                                <label class="custom-control-label cursor-pointer" data-bind="text:Nombre(), attr: { for: SellingId()  }"></label>
                            </div>
                        </div>
                        <!-- ko if: $index() == 0 -->
                        <div class="dropdown-divider m-0"></div>
                        <span class="chevron"></span>
                        <!-- /ko -->
                    </div>
                </li>
            </ul>
            <ul class="navbar-nav ml-auto align-items-center">
                <li class="nav-item mx-1">
                    <button type="button" class="btn btn-outline-success h-100">
                        <i class="fa fa-download" aria-hidden="true"></i> Descargar
                    </button>
                </li>
                <li>
                    <i class="fa fa-filter fa-2x mx-1"></i>
                </li>
            </ul>
        </div>
    </nav>
    <div class="text-center" data-bind="visible:visibleLoadingSelling()">
        <div class="spinner-border" style="width: 3rem; height: 3rem;" role="status">
            <span class="sr-only">Loading...</span>
        </div>
    </div>
    <div style="display:none;" data-bind="visible:!visibleLoadingSelling()">
        <div class="d-flex border mb-3 d-blockCelular pb-2 pt-2 panel-shadows">
            <div class="flex-1 p-2">
                <h3 class="m-0 font-weight-bold color-primary-400 mb-2 ml-3">General</h3>
                <div class="d-flex justify-content-around">
                    <div class="text-center mx-2">
                        <h1 class="m-0 fa-2x font-weight-bold" data-bind="text:generalSellingActivos() == 0 ? '-' : generalSellingActivos()"></h1>
                        <strong>Selling activo</strong>
                    </div>
                    <div class="text-center mx-2">
                        <h1 class="m-0 fa-2x font-weight-bold" data-bind="text:generalCrossSelling() == 0 ? '-' : generalCrossSelling()"></h1>
                        <strong>Cross-selling</strong>
                    </div>
                    <div class="text-center mx-2">
                        <h1 class="m-0 fa-2x font-weight-bold" data-bind="text:generalUpSelling() == 0 ? '-' : generalUpSelling()"></h1>
                        <strong>Up-selling</strong>
                    </div>
                    <div class="text-center mx-2">
                        <h1 class="m-0 fa-2x font-weight-bold" data-bind="text:generalMensajesEnviados() == 0 ? '-' : generalMensajesEnviados()"></h1>
                        <strong>Productos conectados</strong>
                    </div>
                    <div class="text-center mx-2">
                        <h1 class="m-0 fa-2x font-weight-bold" data-bind="text:generalProductosConectados() == 0 ? '-' : generalProductosConectados()"></h1>
                        <strong>Mensajes enviados</strong>
                    </div>
                </div>
            </div>

            <div class="border my-2 d-none d-sm-block"></div>

            <div class="flex-1 p-2">
                <h3 class="m-0 font-weight-bold color-primary-400 mb-2 ml-3">Carritos recuperados</h3>
                <div class="d-flex justify-content-around">
                    <div class="text-center mx-2">
                        <h1 class="m-0 fa-2x font-weight-bold" data-bind="text:carritosRecuperadosMesajesRespondidos() == 0 ? '-' : carritosRecuperadosMesajesRespondidos()"></h1>
                        <strong>Mensajes respondidos</strong>
                    </div>
                    <div class="text-center mx-2">
                        <h1 class="m-0 fa-2x font-weight-bold" data-bind="text:carritosRecuperados() == 0 ? '-' : carritosRecuperados()"></h1>
                        <strong>Carritos recuperados</strong>
                    </div>
                    <div class="text-center mx-2">
                        <h1 class="m-0 fa-2x font-weight-bold" data-bind="text:carritosRecuperadosFacturacion() == 0 ? '-' : carritosRecuperadosFacturacion()"></h1>
                        <strong>Facturación</strong>
                        <div class="mt-2" data-bind="visible:carritosRecuperadosFacturacionList().length > 1" style="display:none;">
                            <i class="fas fa-info-circle info-icon cursor-pointer infoPopover" id="infoCarritosRecuperadosFacturacion" tabindex="0" data-toggle="popover"></i>
                        </div>
                    </div>
                    <div class="text-center mx-2">
                        <h1 class="m-0 fa-2x font-weight-bold" data-bind="text:carritosRecuperadosPerformance() == 0 ? '-' : carritosRecuperadosPerformance() + ' %'"></h1>
                        <strong>Performance (total / recuperados)</strong>
                    </div>
                </div>
            </div>

            <div class="border my-2 d-none d-sm-block"></div>

            <div class="flex-1 p-2">
                <h3 class="m-0 font-weight-bold color-primary-400 mb-2 ml-3">Carritos cerrados</h3>
                <div class="d-flex justify-content-around">
                    <div class="text-center mx-2">
                        <h1 class="m-0 fa-2x font-weight-bold" data-bind="text:carritosCerradosVendidos() == 0 ? '-' : carritosCerradosVendidos()"></h1>
                        <strong>Carritos vendidos</strong>
                    </div>
                    <div class="text-center mx-2">
                        <h1 class="m-0 fa-2x font-weight-bold" data-bind="text:carritosCerradosFacturacion() == 0 ? '-' : carritosCerradosFacturacion()"></h1>
                        <strong>Facturación</strong>
                        <div class="mt-2" data-bind="visible:carritosCerradosFacturacionList().length > 1" style="display:none;">
                            <i class="fas fa-info-circle info-icon cursor-pointer infoPopover" id="infoCarritosCerradosFacturacion" tabindex="0" data-toggle="popover"></i>
                        </div>
                    </div>
                    <div class="text-center mx-2">
                        <h1 class="m-0 fa-2x font-weight-bold" data-bind="text:carritosCerradosPerformance() == 0 ? '-' : carritosCerradosPerformance() + ' %'"></h1>
                        <strong>Performance (recuperados / cerrados)</strong>
                    </div>
                </div>
            </div>
        </div>
        <div class="panel mb-3 panel-shadows">
            <div class="panel-container">
                <div class="panel-content pb-5">
                    <div class="row">
                        <div class="col-lg-12 col-xl-6">
                            <h3 class="font-weight-bold color-primary-400 mb-2">Productos</h3>
                            <canvas id="canvasChartCantidadProductos" style="max-height:250px; width: 100%; min-height:250px !important;"></canvas>
                        </div>
                        <div class="col-lg-6 col-xl-4 col-xs-12" data-bind="visible:monedasListProductosFacturados().length" style="display:none;">
                            <div class="d-flex mb-2 align-items-center">
                                <h3 class="font-weight-bold color-primary-400 mb-0">
                                    Facturados <span data-bind="text:selectedMonedaSimboloProductosFacturados()"></span>
                                </h3>
                                <ul class="navbar-nav ml-2">
                                    <li class="dropdown">
                                        <a href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                            <em class="fa fa-chevron-down"></em>
                                        </a>
                                        <div class="dropdown-menu fadeindown" data-bind="foreach:monedasListProductosFacturados()">
                                            <div class="dropdown-item">
                                                <div class="custom-control custom-radio">
                                                    <input type="radio" class="custom-control-input" name="monedaRadioProductosFacturados" data-bind="checked: $root.monedaSeleccionadaProductosFacturados,click:$root.seleccionarMonedaProductosFacturados, value: MonedaId(), attr: { id: MonedaId() + '_ProductosFacturados'}">
                                                    <label class="custom-control-label cursor-pointer" data-bind="text: NombreDescripcion(), attr: { for: MonedaId()  + '_ProductosFacturados'}"></label>
                                                </div>
                                            </div>
                                        </div>
                                    </li>
                                </ul>
                            </div>
                            <canvas id="canvasChartProductosFacturadosS" style="max-height:250px; width: 100%; min-height:250px !important;"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="panel mb-3 panel-shadows">
            <div class="panel-container">
                <div class="panel-content pb-5">
                    <div class="row">
                        <div class="col-lg-12 col-xl-6">
                            <h3 class="font-weight-bold color-primary-400 mb-2">Selling</h3>
                            <canvas id="canvasChartCantidadSelling" style="max-height:250px; width: 100%; min-height:250px !important;"></canvas>
                        </div>
                        <div class="col-lg-6 col-xl-6 col-xs-12" data-bind="visible:monedasListSellingFacturados().length" style="display:none;">
                            <div class="d-flex mb-2 align-items-center">
                                <h3 class="font-weight-bold color-primary-400 mb-0">
                                    Facturados <span data-bind="text:selectedMonedaSimboloSellingFacturados()"></span>
                                </h3>
                                <ul class="navbar-nav ml-2">
                                    <li class="dropdown">
                                        <a href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                            <em class="fa fa-chevron-down"></em>
                                        </a>
                                        <div class="dropdown-menu fadeindown" data-bind="foreach:monedasListSellingFacturados()">
                                            <div class="dropdown-item">
                                                <div class="custom-control custom-radio">
                                                    <input type="radio" class="custom-control-input" name="monedaRadioSellingFacturados" data-bind="checked: $root.monedaSeleccionadaSellingFacturados,click:$root.seleccionarMonedaSellingFacturados, value: MonedaId(), attr: { id: MonedaId() + '_SellingFacturados'}">
                                                    <label class="custom-control-label cursor-pointer" data-bind="text: NombreDescripcion(), attr: { for: MonedaId()  + '_SellingFacturados'}"></label>
                                                </div>
                                            </div>
                                        </div>
                                    </li>
                                </ul>
                            </div>
                            <canvas id="canvasChartSellingFacturadosS" style="max-height:250px; width: 100%; min-height:250px !important;"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="panel mb-3 panel-shadows">
            <div class="panel-container">
                <div class="panel-content">
                    <div class="row">
                        <div class="col-lg-12 col-xl-12 mt-2" style="display:none;" data-bind="visible:embudoVentasList().length">
                            <h3 class="font-weight-bold color-primary-400 mb-2">Embudo de ventas</h3>
                            <div class="overflow-auto" style="max-height: 250px; min-height: 250px;display:flex;justify-content:center;">
                                <div class="funnel-container h-100 mx-1" data-bind="foreach: { data: embudoVentasList(), as: 'embudoVentas' }">
                                    <div class="align-items-center d-flex flex-column justify-content-center" data-bind="style: { height: embudoVentas.CalculaHeight($index(), $root.embudoVentasList()) }">
                                        <span class="font-weight-bold" data-bind="text: embudoVentas.Nombre(), style: { color: embudoVentas.Color($index()) }"></span>
                                        <span class="font-weight-bold" data-bind="text: embudoVentas.Cantidad()"></span>
                                    </div>
                                </div>
                                <div class="funnel-container h-100 mx-1" data-bind="foreach: { data: embudoVentasList(), as: 'embudoVentas' }">
                                    <div class="funnel-step" data-bind="style: { width: embudoVentas.CalculaWidth($index(), $root.embudoVentasList()),
                                                height: embudoVentas.CalculaHeight($index(), $root.embudoVentasList()),
                                                borderLeft: embudoVentas.CalculaBorder($index(), $root.embudoVentasList()),
                                                borderRight: embudoVentas.CalculaBorder($index(), $root.embudoVentasList()),
                                                borderTop:embudoVentas.CalculaBorderTop($index(), $root.embudoVentasList())}">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>