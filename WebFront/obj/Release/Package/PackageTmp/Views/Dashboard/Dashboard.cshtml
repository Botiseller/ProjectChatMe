@section scripts
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script src="https://code.highcharts.com/highcharts.js"></script>
    <script src="https://code.highcharts.com/modules/funnel.js"></script>
    <script src="https://code.highcharts.com/modules/sankey.js"></script>
    <script src="https://code.highcharts.com/modules/exporting.js"></script>
    <script src="https://code.highcharts.com/modules/export-data.js"></script>
    <script src="https://code.highcharts.com/modules/accessibility.js"></script>

    @Scripts.Render("~/Scripts" + Common.Utility.Helper.getVersionScript() + "/Models/Dashboard/Section/SectionCampanias.js")
    @Scripts.Render("~/Scripts" + Common.Utility.Helper.getVersionScript() + "/Models/Dashboard/Section/SectionSelling.js")

    @Scripts.Render("~/Scripts" + Common.Utility.Helper.getVersionScript() + "/Models/Dashboard/Dashboard.js")
}

<div class="panel">
    <div class="border-faded border-top-0 border-right-0 border-left-0 shadow-0" id="Dashboard">
        <div class="panel-toolbar">
            <ul class="nav nav-pills w-100 ulBarraNavegacion" role="tablist">
                <li class="nav-item col p-0">
                    <a class="nav-link fs-lg px-4 h-100 d-flex justify-content-center cursor-pointer active" id="SectionCampaniasTab" data-bind="click:buttonSeleccionarTab.bind($data, 1)">
                        <i class="fal fa-megaphone lightBlue my-auto greenImportant"></i>
                        <span class="hidden-sm-down ml-1 my-auto greenImportant">Campañas</span>
                    </a>
                </li>
                <li class="nav-item col p-0">
                    <a class="nav-link fs-lg px-4 h-100 d-flex justify-content-center cursor-pointer" id="SectionSellingTab" data-bind="click:buttonSeleccionarTab.bind($data, 2)">
                        <i class="fal fa-shopping-cart my-auto"></i>
                        <span class="hidden-sm-down ml-2 my-auto">Selling</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
    <div class="panel-container" style="min-height: calc(100vh - 200px);">
        <div class="panel-content pt-3 h-100">
            <div class="tab-content h-100">
                <div class="tab-pane fade active show h-100" id="SectionCampaniasPanel">
                    @{ Html.RenderPartial("~/Views/Dashboard/Section/SectionCampanias.cshtml"); }
                </div>
                <div class="tab-pane fade h-100" id="SectionSellingPanel">
                    @{ Html.RenderPartial("~/Views/Dashboard/Section/SectionSelling.cshtml"); }
                </div>
            </div>
        </div>
    </div>
</div>
