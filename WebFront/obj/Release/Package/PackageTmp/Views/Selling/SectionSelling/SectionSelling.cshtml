@Scripts.Render("~/Scripts" + Common.Utility.Helper.getVersionScript() + "/Models/Selling/SectionSelling/SectionSelling.js")

<style>


    #SectionSelling .cardCampaigne {
        background: white !important;
        border-radius: 14px !important;
        border: 1px solid #e6e3f0 !important;
        padding: 24px !important;
        margin-bottom: 20px !important;
        display: block !important;
    }

    #SectionSelling .cardCampaigne-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 600;
        margin-bottom: 20px;
        font-size: 16px;
    }

</style>




<div id="SectionSelling" class="pb-2">
    <form id="formValidarSectionSelling" role="form">
        <div class="col-9 float-left">
            <div class="form-row mb-4">
                <div class="col-12">
                    <div class="divCardContainer container d-flex align-items-center justify-content-center w-100" data-bind="foreach:tipoSellingList">
                        <div class="divCard divCard-s  col-sm-12 col-md-6 col-lg-3 mx-4 cursor-pointer" data-bind="click: BotonSeleccionar, css: { 'active': Check() }">
                            <em data-bind="css: Icono()" class="color-info-600 "></em>
                            <h3 class="mt-4" data-bind="text:Nombre()"></h3>
                            <span data-bind="text: Descripcion()"></span>
                        </div>
                    </div>
                </div>
                

            </div>


            <div class="row">
                <div class="col-6">
                    <div class="cardCampaigne ml-2">

                        <div class="cardCampaigne-title">
                            <span class="fa fa-comments color-info-900"></span> Mensaje a enviar

                        </div>

                        <div class="row">
                            <div class="col-12">
                                <textarea type="text" id="txtMensaje" maxlength="1000" rows="3" class="form-control text-trush-ico" data-input-value="action-text-mensaje" data-bind="value: mensaje" required="required" placeholder="Mensaje" style="resize:unset;"></textarea>
                                <div class="position-absolute emoji-ico" data-emoji="action-text-mensaje" style="right:55px;">
                                    @{ Html.RenderPartial("~/Views/Shared/Modal/ModalEmojis.cshtml"); }
                                </div>
                                <div class="position-absolute varsConst-ico" data-varsConst="action-text-mensaje" data-filter-variable="filter-action-mensaje" style="right:25px;">
                                    @{ Html.RenderPartial("~/Views/Shared/Modal/ModalVarsConsts.cshtml"); }
                                </div>
                                <div class="invalid-feedback">Campo obligatorio.</div>
                                <div class="valid-feedback">
                                    Correcto!
                                </div>


                            </div>
                            <div class="col-12 mt-2">
                                <button class="btn btn-outline-primary btn-pills ml-2 divVisibleFalse" data-bind="click: buttonAgregarAction, visible:actionList().length < 5" type="button">
                                    <span class="fal fa-plus mr-1"></span>Agregar opción
                                </button>
                            </div>

                            <div class="col-12 mt-2">
                                <div style="display:none;" data-bind="visible: actionList().length">
                                    <!-- ko foreach: { data: actionList(), as: 'action' } -->
                                    <div class="d-flex align-items-center text-center my-1">
                                        <input type="text" class="form-control mx-1" required="required" placeholder="Nombre" maxlength="100" data-bind="value: action.Nombre" />
                                        <select data-allow-clear="false" class="form-control mx-1" required="required" data-bind="options: $root.intentsList, optionsText: 'Nombre', optionsValue: 'Id', value: action.IntentId, attr:{ id:action.ActionId() }"></select>
                                        <button class="btn btn-outline-danger mx-1 divVisibleFalse col-3" data-bind="click: action.ButtonEliminar">
                                            <i class="fa fa-trash-alt mr-2"></i>Eliminar botón
                                        </button>
                                    </div>
                                    <!-- /ko -->
                                </div>


                            </div>

                            <div class="col-12 mt-2">
                                <div class="form-row mb-4">
                                    <div class="col-12">
                                        <label class="form-label" for="txtNombre">Intent Siguiente <span class="text-danger">*</span> </label>
                                        <select id="txtIntentContinuar" data-allow-clear="false" class="form-control select-control mx-1" required="required" data-bind="options: $root.intentsList, optionsText: 'Nombre', optionsValue: 'Id', value: IntentContinuar"></select>
                                        <div class="invalid-feedback">Campo obligatorio.</div>
                                        <div class="valid-feedback">
                                            Correcto!
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>



                    </div>
                </div>
                <div class="col-6">
                    <div class="cardCampaigne ml-2">

                        <div class="cardCampaigne-title">
                            <span><span class="fa fa-bell color-info-900"></span> Avisos programados</span>
                            


                            <div class="ml-5">
                                <div class="mb-2">
                                    <button class="btn btn-outline-primary btn-pills ml-2 divVisibleFalse" style="flex:auto;" data-bind="click: buttonAgregarAvisos, visible:avisosList().length < 5" type="button">
                                        <span class="fal fa-plus mr-1"></span>Agregar aviso
                                    </button>
                                </div>
                            </div>

                        </div>

                        <div class="row">

                            <div class="col-12 mt-2">
                                <div class="d-flex justify-content-center mb-2">
                                    <div class="alert alert-warning alert-dismissible fade show mb-3">
                                        <div class="d-flex align-items-center">
                                            <div class="alert-icon ">
                                                <i class="fas fa-info-circle"></i>
                                            </div>
                                            <div class="flex-1">
                                                Define cuando se enviarán los recordatorios despues de la interacción generada por el usuario.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            



                            <div class="col-12 mt-2">
                                <!-- ko foreach: { data: avisosList(), as: 'aviso' } -->
                                <div class="row">
                                    <div class="col-6">
                                        <div class="align-self-center text-center my-1 ">
                                            <input type="text" class="form-control form-control-sm mx-1 inputmaskInteger float-right mb-1" data-inputmask="'alias': 'integer'" im-insert="true" required="required" data-bind="value: aviso.Hora, css: {'ml-4': aviso.Orden() != 1 }" style="width:100px;">

                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="align-self-center text-center my-1 ">
                                            <button class="btn btn-outline-danger mx-1 divVisibleFalse float-left" data-bind="visible: aviso.Orden() != 1, click: aviso.ButtonEliminar">
                                                <i class="fa fa-trash-alt mr-2"></i>
                                                Eliminar aviso
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <!--/ko-->
                            </div>



                        </div>



                    </div>

                </div>

            </div>


            
        </div>
        <div class="col-3 float-right d-flex justify-content-center">
            <div class="wa-phone-preview">
                <div class="wa-phone__frame">
                    <div class="wa-phone__notch"></div>

                    <!-- Header -->
                    <div class="wa-header">
                        <div class="wa-avatar">B</div>
                        <div class="wa-header-text">
                            <div class="wa-header-title">Botiseller</div>
                            <div class="wa-header-subtitle">Empresa verificada</div>
                        </div>
                    </div>

                    <!-- Chat -->
                    <div class="wa-chat">
                        <div class="wa-message">
                            <div class="wa-message-text" id="waMessageText" data-bind="html:mensaje()"></div>
                            <div style="display:none;" data-bind="visible: actionList().length">
                                <div class="wa-buttons" id="waButtons">
                                    <!-- ko foreach: { data: actionList(), as: 'action' } -->
                                    <div class="wa-btn" data-bind="html: action.Nombre"></div>
                                    <!-- /ko -->
                                </div>
                            </div>

                            
                        </div>

                    </div>

                    <!-- Input -->
                    <div class="wa-input">
                        <span class="fal fa-smile"></span>
                        <div class="wa-input-box">Mensaje</div>
                        <span class="fa fa-microphone"></span>
                        <span class="wa-send fa fa-arrow-right"></span>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>