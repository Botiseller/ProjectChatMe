@Scripts.Render("~/Scripts" + Common.Utility.Helper.getVersionScript() + "/Models/Campanias/SectionFin/SectionFin.js")

<style>

    .campaign-finish-title {
        font-size: 22px;
        font-weight: 600;
        margin-bottom: 14px;
        color: #2e2e3a;
    }

    .campaign-summary-card {
        background: white;
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 24px;
        border: 1px solid #e6e3f0;
        -webkit-box-shadow: 0px 0px 13px 0px rgba(74, 53, 107, 0.08);
        box-shadow: 0px 0px 13px 0px rgba(74, 53, 107, 0.08);
    }

        .campaign-summary-card label {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 500;
            color: #4a4a65;
        }

        .campaign-summary-card i {
            color: #6f4bd8;
        }


    .audience-badge.segment {
        background: #edf7ff;
        color: #2176ff;
    }

    .audience-badge {
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 6px;
    }


</style>







<div id="SectionFin" class="pb-2">
    <form id="formValidarSectionFin">

        <div class="row">
            <div class="col-12">
                <h2 class="campaign-finish-title" data-bind="text: 'Selling: ' + masterSectionDatosGeneralesVM.nombre()"></h2>
            </div>
        </div>

        <div class="row campaign-summary-card">

            <div class="col-8" style="font-size:13px;">
                <div class="form-row">
                    <div class="col-lg-10 col-xs-12 mb-2">
                        <label class="form-label">
                            <i class="fal fa-calendar-alt mr-2"></i>
                            <span> Fecha:  </span>
                            <span data-bind="text: moment(masterSectionDatosGeneralesVM.fechaInicio()).format('DD/MM/YYYY')"></span>
                            <span data-bind="visible:  masterSectionDatosGeneralesVM.conFechaFin"> al </span>
                            <span data-bind="visible:  masterSectionDatosGeneralesVM.conFechaFin, text: moment(masterSectionDatosGeneralesVM.fechaFin()).format('DD/MM/YYYY')"></span>
                        </label>

                    </div>
                    <div class="col-lg-2 col-xs-12 mb-2">
                        <div class="custom-control custom-switch AligneCenter">
                            <input type="checkbox" class="custom-control-input" disabled data-bind="checked: masterSectionDatosGeneralesVM.habilitado">
                            <label class="custom-control-label">Activa</label>
                        </div>
                    </div>
                </div>
                <div class="form-row" data-bind="visible: masterSectionDatosGeneralesVM.descripcion() != null && masterSectionDatosGeneralesVM.descripcion() != ''">
                    <div class="col-12 mb-2">
                        <label class="form-label">
                            <i class="fal fa-sticky-note mr-2"></i>
                            <span> Descripción:  </span>
                            <span data-bind="text:masterSectionDatosGeneralesVM.descripcion"></span>
                        </label>
                    </div>
                </div>



                <div class="mb-4">
                    <label class="form-label">
                        <i class="fal  fa-bell mr-2"></i>
                        <span> Avisos:  </span>
                        <!-- ko foreach: { data: masterSectionSellingVM.avisosList(), as: 'aviso' } -->
                        <span class="audience-badge segment"><i class="fas fa-clock"></i><span data-bind="text: aviso.Hora() + ' Horas'"></span></span>
                        <!-- /ko -->


                    </label>

                </div>

                <div class="form-row">
                    <div class="divCardContainer container d-flex align-items-center justify-content-center w-100" data-bind="foreach:masterSectionSellingVM.tipoSellingList()">
                        <div class="divCard divCard-s col-sm-12 col-md-6 col-lg-3 mx-4" data-bind="css: { 'active': Check() }">
                            <em data-bind="css: Icono()"></em>
                            <h3 class="mt-4" data-bind="text:Nombre()"></h3>
                            <span data-bind="text: Descripcion()"></span>
                        </div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="d-flex mb-2 mt-4 w-100">
                        <div class="d-flex align-items-center font-weight-bold text-center">
                            <span style="font-size:14px;"><i class="fa fa-store mr-2"></i>Producto vinculados</span>
                        </div>
                    </div>
                    <div class="d-flex flex-column">
                        <!-- ko foreach: { data: masterSectionProductosVM.productosVinculadosList(), as: 'productoVinculado' } -->
                        <div class="d-flex align-items-center my-1" style="justify-content: space-between;">
                            <div class="col-6">
                                <!-- ko if: !isNaN(productoVinculado.ImagenProductoPrincipal()) -->
                                <span data-bind="attr: { class: 'iconoAvatar iconoAvatarSmall ' + productoVinculado.NombreProductoPrincipal().charAt(0).toLocaleLowerCase() }, text:productoVinculado.NombreProductoPrincipal().charAt(0).toLocaleUpperCase()" style="display: block; width: 30px !important; height: 30px !important;"></span>
                                <!-- /ko -->
                                <!-- ko ifnot:  !isNaN(productoVinculado.ImagenProductoPrincipal()) -->
                                <img class="profile-image-md rounded-circle imgImagenSmall" data-bind="attr: { src: productoVinculado.ImagenProductoPrincipal() }" style="display: block; width: 40px !important; height: 40px !important; padding: 7px; border: 1px solid #EDE0FB;" />
                                <!-- /ko -->
                                <span class="ml-2" data-bind="text: productoVinculado.NombreProductoPrincipal()"></span>
                            </div>
                            <div class="col-6">
                                <!-- ko if: !isNaN(productoVinculado.ImagenProductoSincronizado()) -->
                                <span data-bind="attr: { class: 'iconoAvatar iconoAvatarSmall ' + productoVinculado.NombreProductoSincronizado().charAt(0).toLocaleLowerCase() }, text:productoVinculado.NombreProductoSincronizado().charAt(0).toLocaleUpperCase()" style="display: block; width: 30px !important; height: 30px !important; "></span>
                                <!-- /ko -->
                                <!-- ko ifnot:  !isNaN(productoVinculado.ImagenProductoSincronizado()) -->
                                <img class="profile-image-md rounded-circle imgImagenSmall" data-bind="attr: { src: productoVinculado.ImagenProductoSincronizado() }" style="display: block; width: 40px !important; height: 40px !important; padding: 7px; border: 1px solid #EDE0FB;" />
                                <!-- /ko -->
                                <span class="ml-2" data-bind="text: productoVinculado.NombreProductoSincronizado()"></span>
                            </div>
                        </div>
                        <!-- /ko -->
                    </div>
                </div>

            </div>

            <div class="col-4">
                <div class="wa-phone-preview">
                    <div class="wa-phone__frame">
                        <div class="wa-phone__notch"></div>

                        <!-- Header -->
                        <div class="wa-header">
                            <div class="wa-avatar">B</div>
                            <div class="wa-header-text">
                                <div class="wa-header-title">Botiseller</div>
                                <div class="wa-header-subtitle">Empresa verificada</div>
                            </div>
                        </div>

                        <!-- Chat -->
                        <div class="wa-chat">
                            <div class="wa-message">
                                <div class="wa-message-text" id="waMessageText" data-bind="text:masterSectionSellingVM.mensaje()"></div>
                                <div style="display:none;" data-bind="visible: masterSectionSellingVM.actionList().length">
                                    <div class="wa-buttons" id="waButtons">
                                        <!-- ko foreach: { data: masterSectionSellingVM.actionList(), as: 'action' } -->
                                        <div class="wa-btn" data-bind="html: action.Nombre"></div>
                                        <!-- /ko -->
                                    </div>
                                </div>


                            </div>

                        </div>

                        <!-- Input -->
                        <div class="wa-input">
                            <span class="fal fa-smile"></span>
                            <div class="wa-input-box">Mensaje</div>
                            <span class="fa fa-microphone"></span>
                            <span class="wa-send fa fa-arrow-right"></span>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </form>
</div>