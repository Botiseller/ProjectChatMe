@using System.Web.Optimization
@using Common.Utility

@model JsonResult

@{
    Layout = "~/Views/_BaseFrameLayout.cshtml";
    ViewBag.Title = "Selling";
    ViewBag.SubTitle = "Crea campañas que relacionen productos, de esta forma podras ofrencer productos sustitutos o productos relacioandos según los intereses de tu cliente.";

}

@section scripts
{
    <script type="text/javascript">
        $(".subheader-icon.fal").addClass("fal fa-shopping-cart");
    </script>
    @Scripts.Render("~/Scripts" + Common.Utility.Helper.getVersionScript() + "/Models/Selling/SectionDatosGenerales/SectionDatosGenerales.js")





    @Scripts.Render("~/Scripts" + Common.Utility.Helper.getVersionScript() + "/Models/Selling/Selling.js")
    @Scripts.Render("~/Scripts" + Common.Utility.Helper.getVersionScript() + "/Models/Selling/CrearSelling.js")
}



<style>
    .boti-campaign-card {
        background: #ffffff;
        border-radius: 16px;
        /* BORDE */
        border: 1px solid #e9e6f2;
        /* SOMBRA SUAVE */
        box-shadow: 0 6px 18px rgba(111, 75, 216, 0.08);
        padding: 18px;
        display: flex;
        flex-direction: column;
        gap: 7px;
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
        height: 215px;
    }

        /*.boti-campaign-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 18px;
        box-shadow: 0 8px 24px rgba(111, 75, 216, 0.08);
        display: flex;
        flex-direction: column;
        gap: 12px;
        transition: transform .2s, box-shadow .2s;
    }*/

        .boti-campaign-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 28px rgba(111, 75, 216, 0.14);
        }

    /* HEADER */
    .boti-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .boti-campaign-title {
        font-weight: 600;
        font-size: 16px;
        color: #2f2f3b;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .boti-campaign-title i {
            color: #6f4bd8;
        }




    .boti-card-header .title {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        min-width: 0;
    }

        .boti-card-header .title .title-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(111, 75, 216, .10);
            color: #6f4bd8;
            flex: 0 0 auto;
            font-size: 18px;
        }

        .boti-card-header .title .title-text {
            min-width: 0;
        }

        .boti-card-header .title .title-text-name {
            font-size: 16px;
            font-weight: 700;
            color: #1f1d2b;
            line-height: 1.2;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .boti-card-header .title title-text-desc {
            font-size: 12.5px;
            color: #6b6a77;
            margin-top: 2px;
            line-height: 1.35;
            max-height: 34px;
            overflow: hidden;
        }


    /* STATUS */
    .boti-status {
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

        .boti-status.active {
            background: #e9f8f3;
            color: #15a77f;
        }

        .boti-status.paused {
            background: #fff7e6;
            color: #b7791f;
        }

        .boti-status.finished {
            background: #f1f1f5;
            color: #6b6b80;
        }

    .boti-campaign-card.paused {
        border-color: #f0d9b5;
        background: #fffdf7;
    }

    .boti-campaign-card.finished {
        opacity: .75;
        background: #fafafa;
        border-color: #e4e4eb;
    }


    /* HIGHLIGHTS */
    .boti-highlights {
        display: flex;
        justify-content: space-between;
        gap: 8px;
    }

    .boti-segment {
        background: #f2edff;
        color: #6f4bd8;
        padding: 6px 10px;
        border-radius: 8px;
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .boti-days {
        background: #fff3cd;
        color: #8a6d3b;
        padding: 6px 12px;
        border-radius: 30px;
        font-weight: 600;
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    /* FECHAS */
    .boti-dates {
        font-size: 13px;
        color: #6c6c80;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    /* CHANNELS */
    .boti-channels {
        display: flex;
        gap: 10px;
        font-size: 18px;
    }

        .boti-channels .whatsapp {
            color: #25d366;
        }

        .boti-channels .mail {
            color: #7b5cff;
        }

        .boti-channels .form {
            color: #00bfa6;
        }

    /* AUDIENCE */
    .boti-audience {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .audience-badge {
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .audience-badge.segment {
            background: #edf7ff;
            color: #2176ff;
        }

        .audience-badge.file {
            background: #fef2f2;
            color: #c53030;
        }
</style>



<div id="Selling">
    <div class="mb-0">
        <div class="">
            <nav class="navbar navbar-expand-lg navbar-light">
                <ul class="navbar-nav mr-auto col-lg-4">
                    <li class="nav-item w-100">
                        <div class="input-group rounded">
                            <input type="text" class="form-control" placeholder="Buscar por titulo..." role="search" id="txtBuscar" maxlength="120">
                            <div class="input-group-append">
                                <button class="btn btn-primary" type="button"><i class="fal fa-search"></i></button>
                            </div>
                        </div>
                    </li>
                </ul>

                <button class="navbar-toggler mt-1 mb-1" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="true" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav d-flex flex-row align-items-center w-100">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle fs-xl text-truncate text-truncate-lg text-info" href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                Tipo
                            </a>
                            <div class="dropdown-menu fadeindown" data-bind="foreach:tipoSellingList">
                                <div class="dropdown-item">
                                    <div class="custom-control custom-checkbox">
                                        <input type="checkbox" class="custom-control-input" data-bind="checked: Check,click: $root.buttonCheck, attr:{ id: TipoSellingId()}">
                                        <label class="custom-control-label cursor-pointer" data-bind="text:Nombre(), attr:{ for: TipoSellingId()}"></label>
                                    </div>
                                </div>
                                <!-- ko if: $index() == 0 -->
                                <span class="chevron"></span>
                                <!-- /ko -->
                            </div>
                        </li>
                        <li class="nav-item ml-auto">
                            <button class="btn btn-outline-success" data-bind="click:buttonCrearSelling"><i class="fas fa-plus mr-2"></i>Diseñar selling</button>
                        </li>
                    </ul>
                </div>

                <div class="ml-auto">
                </div>
            </nav>
            <div class="overflow-auto" style="height: calc(100vh - calc(115px)); overflow-x: hidden !important;">
                <div class="panel-content">
                    <div class="row">

                        <div class="col-12" role="status" data-bind="visible: !load()">
                            @{ Html.RenderPartial("~/Views/Shared/_Loading.cshtml"); }
                        </div>
                        <div class="col-sm-6 col-xl-3 mb-2" data-bind="visible: load()">
                            <!-- ko foreach: { data: sellingList(), as: 'selling' }  -->
                            <div  data-bind="click:selling.ButtonCrearSelling,visible:$root.sellingList().length" style="display:none;">
                                <div class="boti-campaign-card cursor-pointer">
                                    <div class="boti-card-header">


                                        <div class="title">
                                            <div class="title-icon">
                                                <i class="fa fa-shopping-cart"></i>
                                            </div>
                                            <div class="title-text">
                                                <div class="title-text-name" data-bind="text:selling.Nombre()">test</div>
                                                <div class="title-text-desc text-break-1" data-bind="text:selling.Descripcion()">description</div>
                                            </div>
                                        </div>

                                        <!-- ko if: selling.Habilitado() && moment(selling.FechaInicio(), 'DD/MM/YYYY').isAfter(moment(), 'day') -->
                                        <span class="boti-status active cursor-pointer" data-bind="click:selling.ButtonHabilitar">
                                            Por comenzar
                                        </span>
                                        <!-- /ko -->
                                        <!-- ko if: selling.Habilitado() && moment(selling.FechaInicio(), 'DD/MM/YYYY').isBefore(moment(), 'day') && (!selling.FechaFin() || moment(c.FechaFin(), 'DD/MM/YYYY').isSameOrAfter(moment(), 'day')) -->
                                        <span class="boti-status active cursor-pointer" data-bind="click:selling.ButtonHabilitar">
                                            Activa
                                        </span>
                                        <!-- /ko -->
                                        <!-- ko if: selling.Habilitado() && selling.FechaFin() && moment(selling.FechaFin(), 'DD/MM/YYYY').isBefore(moment(), 'day') -->
                                        <span class="boti-status finished cursor-pointer">
                                            Completa
                                        </span>
                                        <!-- /ko -->
                                        <!-- ko if: !selling.Habilitado() -->
                                        <span class="boti-status paused cursor-pointer" data-bind="click:selling.ButtonHabilitar">
                                            Pausada
                                        </span>
                                        <!-- /ko -->

                                    </div>


                                    <div class="d-flex w-100 justify-content-between mb-2">
                                        <div class="boti-dates">
                                            <i class="fa fa-calendar"></i>
                                            <span data-bind="text:selling.FechaStr()"></span>

                                        </div>


                                        <span class="d-flex align-items-center boti-days">
                                            <i data-bind="css: selling.TipoSelling().Icono()" style="font-size:14px !important;"></i>
                                            <span data-bind="text:selling.TipoSelling().Nombre()"></span>
                                        </span>
                                    </div>


                                    <div class="d-flex w-100">
                                        <label class="ml-2 mb-0 font-weight-bold">Avisos</label>
                                    </div>
                                    <div class="d-flex w-100">
                                        <span class="audience-badge segment">
                                            <i class="fas fa-clock"></i>
                                            <span data-bind="text: selling.HorasConcatenadas()"></span>
                                        </span>
                                    </div>

                                    <div class="d-flex w-100 ml-4 flex-lg-row-reverse mr-3">
                                        <!-- ko foreach: { data: selling.ProductosVinculadosList(), as: 'productoVinculado' } -->
                                        <!-- ko if: !isNaN(productoVinculado.ImagenProductoPrincipal()) -->
                                        <span data-bind="attr: { class: 'mx-1 iconoAvatar iconoAvatarSmall ' + productoVinculado.NombreProductoPrincipal().charAt(0).toLocaleLowerCase() }, text:productoVinculado.NombreProductoPrincipal().charAt(0).toLocaleUpperCase()" style="display: block; width: 30px !important; height: 30px !important;"></span>
                                        <!-- /ko -->
                                        <!-- ko ifnot:  !isNaN(productoVinculado.ImagenProductoPrincipal()) -->
                                        <img class="profile-image-md rounded-circle imgImagenSmall mx-1" data-bind="attr: { src: productoVinculado.ImagenProductoPrincipal() }" style="display: block; width: 40px !important; height: 40px !important; padding: 7px; border: 1px solid #EDE0FB;" />
                                        <!-- /ko -->
                                        <!-- /ko -->
                                    </div>
                                </div>

                            </div>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section modalshtml
{
    @{
        Html.RenderPartial("~/Views/Selling/CrearSellingModal.cshtml");
    }
}