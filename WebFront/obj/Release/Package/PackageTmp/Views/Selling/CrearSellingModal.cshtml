</style>*@


<div id="modalCrearSelling" class="modal fade view-selling" role="dialog" aria-hidden="true">
    <div class="modal-dialog" style="min-width: 90vw !important;">
        @*<form id="formValidar" role="form" method="post" data-bind="submit: buttonGuardar">*@
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title">
                        <span>
                            <i class="fa fa-users"></i>
                            Selling
                        </span>
                    </h2>

                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true"><i class="fal fa-times"></i></span>
                    </button>
                </div>
                <div class="modal-body mb-2 overflow-auto" style="height: 75vh;">
                    @{ Html.RenderPartial("~/Views/Selling/CrearSelling.cshtml"); }
                </div>

                <div class="modal-footer border-top">
                    <div class="d-flex justify-content-end w-100">
                        <div id="divValidarForm" class="w-100">
                            <button id="btnEliminarSelling" type="button" class="btn btn-outline-danger waves-effect waves-themed ml-3 ml-auto divVisibleFalse float-left" onclick="BotonEliminar();" style="display:none;"><i class="fas fa-trash mr-2"></i>Eliminar</button>
                            <button type="button" id="btnGuardar" class="btn btn-primary ml-3 divVisibleFalse float-right" " onclick="BotonGuardar();"><span class="fal fa-save mr-2"></span>Guardar</button>
                            <button type="button" onclick="BotonCancelar();" class="btn btn-outline-primary waves-effect waves-themed mr-2 float-right">X Cancelar</button>
                        </div>
                        <div id="divEnProceso" style="display:none;">
                            <button type="button" id="btnProcesando" class="btn btn-primary ml-3 divVisibleFalse" disabled style="display:none;">
                                <span class="spinner-border spinner-border-sm mr-2" role="status" aria-hidden="true"></span>
                                Procesando...
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        @*</form>*@
    </div>
</div>
