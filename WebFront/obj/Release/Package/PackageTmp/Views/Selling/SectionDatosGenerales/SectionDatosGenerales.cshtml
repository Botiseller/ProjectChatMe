

<style>
     #SectionDatosGeneralesPanel .card {
         background: var(--card);
         border: 1px solid var(--border);
         border-radius: var(--radius);
         box-shadow: 0 10px 26px rgba(23,18,43,.06);
         flex-direction: row !important;
     }

     /* =========================
    Intro
    ========================= */

     #SectionDatosGeneralesPanel .intro {
         padding: 22px;
         display: flex;
         gap: 18px;
         align-items: flex-start;
         background: linear-gradient(180deg,#ffffff 0%, #fbfaff 100%);
         margin-bottom: 18px;
     }

     #SectionDatosGeneralesPanel .intro-icon {
         width: 42px;
         height: 42px;
         border-radius: 12px;
         background: rgba(111,75,216,.10);
         color: var(--primary);
         display: flex;
         align-items: center;
         justify-content: center;
         font-size: 18px;
         flex: 0 0 auto;
     }

     #SectionDatosGeneralesPanel .intro h2 {
         margin: 0;
         font-size: 20px;
         font-weight: 700;
     }

     #SectionDatosGeneralesPanel .intro p {
         margin: 8px 0 0;
         color: var(--muted);
         font-size: 14px;
         line-height: 1.45;
         max-width: 820px;
     }

     #SectionDatosGeneralesPanel .intro .bullets {
         margin: 14px 0 0;
         padding: 0;
         list-style: none;
         display: grid;
         gap: 8px;
         color: #4f4f68;
         font-size: 13px;
     }

         #SectionDatosGeneralesPanel .intro .bullets li {
             display: flex;
             gap: 10px;
             align-items: flex-start;
         }

         #SectionDatosGeneralesPanel .intro .bullets i {
             color: #3ccf91;
             margin-top: 2px;
         }



     #SectionDatosGeneralesPanel .campaign-types {
         display: grid;
         grid-template-columns: repeat(2, 1fr);
         gap: 16px;
     }

     #SectionDatosGeneralesPanel .type-cardCampaigne {
         border: 1px solid var(--border);
         border-radius: 12px;
         padding: 16px;
         display: flex;
         align-items: center;
         gap: 12px;
         cursor: pointer;
         transition: .15s;
     }

     .type-cardCampaigne.active {
         border-color: #6f4bd8;
         background: #f3efff;
     }

     #SectionDatosGeneralesPanel .type-icon {
         width: 40px;
         height: 40px;
         border-radius: 10px;
         background: #f3efff;
         display: flex;
         align-items: center;
         justify-content: center;
         font-size: 18px;
     }

     #SectionDatosGeneralesPanel .sub-cardCampaigne {
         margin-top: 20px;
         padding: 16px;
         border-radius: 12px;
         background: #faf9ff;
         border: 1px dashed #e6e3f0;
     }

     #SectionDatosGeneralesPanel .sub-option {
         display: block;
         padding: 10px 12px;
         border-radius: 8px;
         cursor: pointer;
     }

         #SectionDatosGeneralesPanel .sub-option:hover {
             background: #f1effb;
         }







     #SectionDatosGeneralesPanel Header .campaign-header {
         display: flex;
         justify-content: space-between;
         align-items: center;
         margin-bottom: 24px;
     }

     #SectionDatosGeneralesPanel .campaign-header h1 {
         margin: 0;
         font-size: 26px;
         font-weight: 600;
     }

     #SectionDatosGeneralesPanel .switch {
         display: flex;
         align-items: center;
         gap: 12px;
         font-weight: 500;
     }

         #SectionDatosGeneralesPanel .switch input {
             appearance: none;
             width: 44px;
             height: 24px;
             background: #ccc;
             border-radius: 999px;
             position: relative;
             cursor: pointer;
         }

             #SectionDatosGeneralesPanel .switch input:checked {
                 background: #3ccf91;
             }

             #SectionDatosGeneralesPanel .switch input::after {
                 content: "";
                 width: 18px;
                 height: 18px;
                 background: white;
                 position: absolute;
                 top: 3px;
                 left: 3px;
                 border-radius: 50%;
                 transition: 0.2s;
             }

             #SectionDatosGeneralesPanel .switch input:checked::after {
                 left: 23px;
             }



     #SectionDatosGeneralesPanel .cardCampaigne {
         background: white !important;
         border-radius: 14px !important;
         border: 1px solid #e6e3f0 !important;
         padding: 24px !important;
         margin-bottom: 20px !important;
         display: block !important;
     }

     #SectionDatosGeneralesPanel .cardCampaigne-title {
         display: flex;
         align-items: center;
         gap: 10px;
         font-weight: 600;
         margin-bottom: 20px;
         font-size: 16px;
     }

         #SectionDatosGeneralesPanel .cardCampaigne-title span {
             color: #6f4bd8;
         }

     #SectionDatosGeneralesPanel Form
     .form-row {
         display: grid;
         grid-template-columns: 1fr 1fr;
         gap: 20px;
     }

     #SectionDatosGeneralesPanel label {
         font-size: 13px;
         color: #7a7a90;
         margin-bottom: 6px;
         display: block;
     }



     #SectionDatosGeneralesPanel .campaign-types {
         display: grid;
         grid-template-columns: repeat(2, 1fr);
         gap: 16px;
     }

     #SectionDatosGeneralesPanel .type-cardCampaigne {
         border: 1px solid #e6e3f0;
         border-radius: 12px;
         padding: 16px;
         display: flex;
         align-items: center;
         gap: 12px;
         cursor: pointer;
         transition: 0.15s;
         position: relative;
     }

         #SectionDatosGeneralesPanel .type-cardCampaigne.active {
             border-color: #6f4bd8;
             background: #f3efff;
         }

             #SectionDatosGeneralesPanel .type-cardCampaigne.active::after {
                 content: "✓";
                 position: absolute;
                 top: 10px;
                 right: 12px;
                 color: #6f4bd8;
                 font-weight: 700;
             }

     #SectionDatosGeneralesPanel .type-icon {
         width: 40px;
         height: 40px;
         border-radius: 10px;
         background: #f3efff;
         display: flex;
         align-items: center;
         justify-content: center;
         color: #6f4bd8;
         font-weight: 700;
     }

     /*#SectionDatosGeneralesPanel Vigencia
     .vigencia {
         display: grid;
         grid-template-columns: 1fr 1fr;
         gap: 16px;
     }*/

     #SectionDatosGeneralesPanel .checkbox {
         margin-top: 16px;
         display: flex;
         align-items: center;
         gap: 10px;
     }
</style>


<div id="SectionDatosGenerales" class="pb-2">

    <div role="status" data-bind="visible: !load()">
        @{ Html.RenderPartial("~/Views/Shared/_Loading.cshtml"); }
    </div>


    <form id="formValidarSectionDatosGenerales" role="form" data-bind="visible: load()">

        <div class="cardCampaigne-title" style="justify-content: space-between; margin-bottom: 24px;">
            <span>
                <span class="fa fa-exclamation-circle color-info-900"></span> Información básica
            </span>
            <label class="switch" style="font-size: 12px; ">
                Activa
                <input id="activeCampagne" type="checkbox" class="form-label" data-bind="checked: habilitado" style="display:block;">
            </label>

        </div>


        <div class="cardCampaigne">

            <div class="" style="display: flex;">
                <div class="card intro">
                    <div class="intro-icon"><i class="fas fa-users fa-lightbulb"></i></div>
                    <div>
                        <h2>Selling</h2>
                        <p>
                            Crea y gestiona selling para terminar de captar las necesidades de tus clientes
                            Crea y gestiona campañas para comunicarte con tus clientes de forma automatizada a través de múltiples canales.
                        </p>

                        <ul class="bullets">
                            <li><i class="fa-check-circle fas"></i> Configura campañas cross-selling para ofrecer productos relacionados a partir de una compra.</li>
                            <li><i class="fa-check-circle fas"></i> Crea campañas up-selling para ofrecer productos mejoras o más económicos para satisfacer las necesidades de una compra no confirmada.</li>
                        </ul>
                    </div>
                </div>

                <div class="basic-grid w-100 ml-4 mt-3" style="grid-template-columns: auto;">

                    <div>
                        <div class="" style="margin-bottom:12px;">
                            <label class="form-label" for="txtNombre">Nombre <span class="text-danger">*</span> </label>
                            <input type="text" id="txtNombre" class="form-control" required="required" placeholder="Nombre" maxlength="100" data-bind="value: nombre" />
                            <div class="invalid-feedback">Campo obligatorio.</div>
                            <div class="valid-feedback">
                                Correcto!
                            </div>
                        </div>

                        <div class="">
                            <label class="form-label" for="txtDescripción">Descripción</label>
                            <textarea id="txtDescripción" class="form-control" placeholder="Descripción" maxlength="1000" rows="3" data-bind="value: descripcion" style="resize:unset;"></textarea>
                        </div>
                    </div>



                </div>

                <div class="cardCampaigne ml-2">

                    <div class="cardCampaigne-title">
                        <span class="fa fa-calendar-alt color-info-900"></span> Vigencia
                    </div>

                    <div class="row divRangoFechaCreacion">
                        <div class="col-12">
                            <label class="form-label" for="txtFechaInicio">Fecha inicio <span class="text-danger">*</span></label>


                            <div class="input-group col pl-0">
                                <input id="txtFechaInicio" type="text" class="form-control datepicker-bottom-left" required="required" placeholder="Fecha inicio" data-bind="value: fechaInicio, event:{ change: changeFechaInicio }">
                                <div class="input-group-sm input-group-append">
                                    <span class="input-group-text fs-xl">
                                        <i class="fal fa-calendar-alt"></i>
                                    </span>
                                </div>
                            </div>

                            <div class="invalid-feedback">Campo obligatorio.</div>
                            <div class="valid-feedback">
                                Correcto!
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="checkbox">
                                <input id="ckcConFechaFin" type="checkbox" data-bind="checked: conFechaFin,event:{ change: changeConFechaFin}">
                                Con fecha de fin
                            </div>
                        </div>
                        <div class="col-12">
                            <label>Fecha fin</label>

                            <div class="input-group col pl-0">
                                <input id="txtFechaFin" type="text" class="form-control datepicker-bottom-left" placeholder="Fecha fin" data-bind="enable: conFechaFin() == true, value: fechaFin, event:{ change: changeFechaFin }">
                                <div class="input-group-sm input-group-append">
                                    <span class="input-group-text fs-xl">
                                        <i class="fal fa-calendar-alt"></i>
                                    </span>
                                </div>
                            </div>

                            <div class="invalid-feedback">Campo obligatorio.</div>
                            <div class="valid-feedback">
                                Correcto!
                            </div>
                        </div>
                    </div>



                </div>

            </div>
        </div>

       
    </form>
</div>