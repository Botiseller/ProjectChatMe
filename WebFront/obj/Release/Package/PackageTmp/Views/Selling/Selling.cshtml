@using System.Web.Optimization

@{
    ViewBag.Title = "Selling";
}

@section scripts
{
    <script type="text/javascript">
        $(".subheader-icon.fal").addClass("fal fa-shopping-cart");
    </script>

    @Scripts.Render("~/Scripts" + Common.Utility.Helper.getVersionScript() + "/Models/Selling/Selling.js")
}

<div id="Selling">
    <div class="panel mb-0">
        <div class="panel-container">
            <nav class="navbar navbar-expand-lg navbar-light border-bottom">
                <ul class="navbar-nav mr-auto col-lg-4">
                    <li class="nav-item w-100">
                        <div class="input-group rounded">
                            <input type="text" class="form-control" placeholder="Buscar por titulo..." role="search" id="txtBuscar" maxlength="120">
                            <div class="input-group-append">
                                <button class="btn btn-primary" type="button"><i class="fal fa-search"></i></button>
                            </div>
                        </div>
                    </li>
                </ul>

                <button class="navbar-toggler mt-1 mb-1" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="true" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav mr-auto">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle fs-xl text-truncate text-truncate-lg text-info" href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                Tipo
                            </a>
                            <div class="dropdown-menu fadeindown" data-bind="foreach:tipoSellingList">
                                <div class="dropdown-item">
                                    <div class="custom-control custom-checkbox">
                                        <input type="checkbox" class="custom-control-input" data-bind="checked: Check,click: $root.buttonCheck, attr:{ id: TipoSellingId()}">
                                        <label class="custom-control-label cursor-pointer" data-bind="text:Nombre(), attr:{ for: TipoSellingId()}"></label>
                                    </div>
                                </div>
                                <!-- ko if: $index() == 0 -->
                                <span class="chevron"></span>
                                <!-- /ko -->
                            </div>
                        </li>
                    </ul>
                </div>

                <div class="ml-auto">
                </div>
            </nav>
            <div class="overflow-auto" style="height: calc(100vh - calc(150px + 100px))">
                <div class="panel-content">
                    <div class="row">
                        <div class="col-sm-6 col-xl-3 mb-2" data-bind="click:buttonCrearSelling">
                            <div class="divCard">
                                <em class="fa fa-megaphone  fa-4x"></em>
                                <h3>Diseñar acciones de selling</h3>
                                <span>Diseña tus acciones de selling para vender más, mejor y mas inteligente.</span>
                            </div>
                        </div>
                        <!-- ko foreach: { data: sellingList(), as: 'selling' }  -->
                        <div class="col-sm-6 col-xl-3 mb-2" data-bind="click:selling.ButtonCrearSelling,visible:$root.sellingList().length" style="display:none;">
                            <div class="divCard divCardEdit">
                                <div class="d-flex w-100 justify-content-between">
                                    <div>
                                        <h2>
                                            <em class="fa fa-shopping-cart float-left mr-1"></em>
                                            <span data-bind="text:selling.Nombre()"></span>
                                        </h2>
                                    </div>
                                    <div>
                                        <input type="checkbox" data-bind="checked: selling.Habilitado(), click:selling.ButtonHabilitar,attr: { 'data-original-title': selling.Habilitado() ? 'Deshabilitar' : 'Habilitar' }" class="cursor-pointer has-tooltip" data-placement="top" data-toggle="tooltip" style="height: 20px !important; width: 20px !important;">
                                    </div>
                                </div>
                                <div class="d-flex w-100 justify-content-between mb-2">
                                    <div>
                                        <label class="ml-4 mb-0" data-bind="text:selling.FechaStr()" style="font-size:12px;"></label>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <em data-bind="css: selling.TipoSelling().Icono()" style="font-size:14px !important;"></em>
                                        <label class="ml-2 mb-0" data-bind="text:selling.TipoSelling().Nombre()"></label>
                                    </div>
                                </div>
                                <div class="d-flex w-100 mb-2">
                                    <label class="ml-4 mb-0 cortarTextoDosRenglones" data-bind="text:selling.Descripcion()"></label>
                                </div>
                                <div class="d-flex w-100">
                                    <label class="ml-2 mb-0 font-weight-bold">Avisos</label>
                                </div>
                                <div class="d-flex w-100">
                                    <label class="ml-4 mb-0" data-bind="text: selling.HorasConcatenadas()"></label>
                                </div>
                                <div class="d-flex w-100 mb-2">
                                    <label class="ml-2 mb-0 font-weight-bold">Productos</label>
                                </div>
                                <div class="d-flex w-100 ml-4">
                                    <!-- ko foreach: { data: selling.ProductosVinculadosList(), as: 'productoVinculado' } -->
                                    <!-- ko if: !isNaN(productoVinculado.ImagenProductoPrincipal()) -->
                                    <span data-bind="attr: { class: 'mx-1 iconoAvatar iconoAvatarSmall ' + productoVinculado.NombreProductoPrincipal().charAt(0).toLocaleLowerCase() }, text:productoVinculado.NombreProductoPrincipal().charAt(0).toLocaleUpperCase()" style="display: block; width: 30px !important; height: 30px !important;"></span>
                                    <!-- /ko -->
                                    <!-- ko ifnot:  !isNaN(productoVinculado.ImagenProductoPrincipal()) -->
                                    <img class="profile-image-md rounded-circle imgImagenSmall mx-1" data-bind="attr: { src: productoVinculado.ImagenProductoPrincipal() }" style="display: block; width: 30px !important; height: 30px !important; " />
                                    <!-- /ko -->
                                    <!-- /ko -->
                                </div>
                            </div>
                        </div>
                        <!-- /ko -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

