@using System.Web.Optimization

@{
    ViewBag.Title = "Selling";
    ViewBag.Subtitle = "Crear un nuevo selling";
}

@section scripts
{
    <script type="text/javascript">
        $(".subheader-icon.fal").addClass("fal fa-shopping-cart");
    </script>

    @Scripts.Render("~/Scripts" + Common.Utility.Helper.getVersionScript() + "/Models/Selling/CrearSelling.js")
}

<div class="mb-0">
    <div class="border-faded border-top-0 border-right-0 border-left-0 shadow-0" id="CrearSelling">
        <div>
            <ul class="nav nav-pills w-100 ulBarraNavegacion" role="tablist">
                <li class="nav-item col p-0">
                    <a class="nav-link fs-lg px-4 h-100 d-flex justify-content-center cursor-pointer active" id="SectionDatosGeneralesTab" data-bind="click:buttonSeleccionarTab.bind($data, 1)">
                        <i class="fal fa-info-circle my-auto greenImportant"></i>
                        <span class="hidden-sm-down ml-2 my-auto greenImportant">Datos generales</span>
                    </a>
                </li>
                <li class="nav-item col p-0">
                    <a class="nav-link fs-lg px-4 h-100 d-flex justify-content-center cursor-pointer" id="SectionSellingTab" data-bind="click:buttonSeleccionarTab.bind($data, 2)">
                        <i class="fal fa-info-circle my-auto greenImportant"></i>
                        <span class="hidden-sm-down ml-2 my-auto">Selling</span>
                    </a>
                </li>
                <li class="nav-item col p-0">
                    <a class="nav-link fs-lg px-4 h-100 d-flex justify-content-center cursor-pointer" id="SectionProductosTab" data-bind="click:buttonSeleccionarTab.bind($data, 3)">
                        <i class="fal fa-shopping-cart lightBlue my-auto"></i>
                        <span class="hidden-sm-down ml-2 my-auto">Productos</span>
                    </a>
                </li>
                <li class="nav-item col p-0">
                    <a class="nav-link fs-lg px-4 h-100 d-flex justify-content-center cursor-pointer" id="SectionFinTab" data-bind="click:buttonSeleccionarTab.bind($data, 4)">
                        <i class="fal fa-bookmark lightBlue my-auto"></i>
                        <span class="hidden-sm-down ml-2 my-auto">Fin</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
    <div>
        <div class="pt-3 h-100">
            
            <div class="tab-content h-100" id="divDisable">
                <div class="tab-pane fade active show h-100" id="SectionDatosGeneralesPanel">
                    @{ Html.RenderPartial("~/Views/Selling/SectionDatosGenerales/SectionDatosGenerales.cshtml"); }
                </div>
                <div class="tab-pane fade h-100" id="SectionSellingPanel">
                    @{ Html.RenderPartial("~/Views/Selling/SectionSelling/SectionSelling.cshtml"); }
                </div>
                <div class="tab-pane fade h-100" id="SectionProductosPanel">
                    @{ Html.RenderPartial("~/Views/Selling/SectionProductos/SectionProductos.cshtml"); }
                </div>
                <div class="tab-pane fade h-100" id="SectionFinPanel">
                    @{ Html.RenderPartial("~/Views/Selling/SectionFin/SectionFin.cshtml"); }
                </div>
            </div>
        </div>
    </div>
    @*<div class="panel-footer d-flex justify-content-end">
        <div class="mr-auto">
            <button id="btnEliminarSelling" type="button" class="btn btn-outline-danger waves-effect waves-themed ml-3 ml-auto divVisibleFalse" onclick="BotonEliminar();" style="display:none;"><i class="fas fa-trash mr-2"></i>Eliminar</button>
        </div>
        <div>
            <a onclick="BotonCancelar();" class="btn btn-outline-primary waves-effect waves-themed mr-2"><span class="mr-2">X</span>Cancelar</a>
            <button type="button" id="btnGuardar" class="btn btn-primary ml-3 divVisibleFalse" onclick="BotonGuardar();"><span class="fal fa-save mr-2"></span>Guardar</button>
            <button type="button" id="btnProcesando" class="btn btn-primary ml-3 divVisibleFalse" disabled style="display:none;"><span class="spinner-border spinner-border-sm mr-2" role="status" aria-hidden="true"></span>Procesando...</button>
        </div>
    </div>*@
</div>
