

@Styles.Render("~/Css" + Common.Utility.Helper.getVersionScript() + "/froala/froala_editor.pkgd.min.css")
@Styles.Render("~/Css" + Common.Utility.Helper.getVersionScript() + "/froala/dark.min.css")

<script src="~/Js/froala/froala_editor.pkgd.min.js" type='text/javascript'></script>



<div id="modalCrearCampania" class="modal fade view-campanias" role="dialog" aria-hidden="true">
    <div class="modal-dialog" style="min-width: 90vw !important;">
        <div class="modal-content">

            <div class="modal-header">
                <h2 class="modal-title">
                    <span>
                        <i class="fa fa-megaphone"></i>
                        Campañías
                    </span>
                </h2>

                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true"><i class="fal fa-times"></i></span>
                </button>
            </div>

            <div class="modal-body mb-2 overflow-auto" style="height: 70vh;">

                <div data-visible="content">

                    <div class="border-faded border-top-0 border-right-0 border-left-0 shadow-0" id="CrearCampanias">
                        <div class="panel-toolbar">
                            <ul class="nav nav-pills w-100 ulBarraNavegacion" role="tablist">
                                <li class="nav-item col p-0">
                                    <a class="nav-link fs-lg px-4 h-100 d-flex justify-content-center cursor-pointer active" id="SectionDatosGeneralesTab" data-bind="click:buttonSeleccionarTab.bind($data, 1)">
                                        <i class="fal fa-info-circle my-auto greenImportant"></i>
                                        <span class="hidden-sm-down ml-2 my-auto greenImportant">Datos generales</span>
                                    </a>
                                </li>
                                <li class="nav-item col p-0">
                                    <a class="nav-link fs-lg px-4 h-100 d-flex justify-content-center cursor-pointer" id="SectionCampaniaTab" data-bind="click:buttonSeleccionarTab.bind($data, 2)">
                                        <i class="fal fa-shopping-cart lightBlue my-auto"></i>
                                        <span class="hidden-sm-down ml-2 my-auto">Campaña</span>
                                    </a>
                                </li>
                                <li class="nav-item col p-0" style="display:none;" data-bind="visible:visibleTabSegmento()">
                                    <a class="nav-link fs-lg px-4 h-100 d-flex justify-content-center cursor-pointer" id="SectionSegmentoTab" data-bind="click:buttonSeleccionarTab.bind($data, 3)">
                                        <i class="fal fa-users lightBlue my-auto"></i>
                                        <span class="hidden-sm-down ml-2 my-auto">Segmento</span>
                                    </a>
                                </li>
                                <li class="nav-item col p-0">
                                    <a class="nav-link fs-lg px-4 h-100 d-flex justify-content-center cursor-pointer" id="SectionFinTab" data-bind="click:buttonSeleccionarTab.bind($data, 4)">
                                        <i class="fal fa-bookmark lightBlue my-auto"></i>
                                        <span class="hidden-sm-down ml-2 my-auto">Fin</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="pt-3 h-100">
                        <div class="tab-content h-100" id="divDisable">
                            <div class="tab-pane fade active show h-100" id="SectionDatosGeneralesPanel">
                                @{ Html.RenderPartial("~/Views/Campanias/SectionDatosGenerales/SectionDatosGenerales.cshtml"); }
                            </div>
                            <div class="tab-pane fade h-100" id="SectionCampaniaPanel">
                                @{ Html.RenderPartial("~/Views/Campanias/SectionCampania/SectionCampania.cshtml"); }
                            </div>
                            <div class="tab-pane fade h-100" id="SectionSegmentoPanel">
                                @{ Html.RenderPartial("~/Views/Campanias/SectionSegmentos/SectionSegmentos.cshtml"); }
                            </div>
                            <div class="tab-pane fade h-100" id="SectionFinPanel">
                                @{ Html.RenderPartial("~/Views/Campanias/SectionFin/SectionFin.cshtml"); }
                            </div>
                        </div>
                    </div>

                </div>


                <div class="align-content-center h-100" style="display: none;" role="status" data-visible="loading">
                    <div role="status">
                        @{ Html.RenderPartial("~/Views/Shared/_Loading.cshtml"); }
                    </div>
                </div>

            </div>



            <div class="modal-footer border-top">
                <div class="d-flex justify-content-end" data-visible="SeccionButtons">
                    <div data-visible="SeccionData">
                        <button type="button" class="btn btn-primary waves-effect waves-themed ml-3" onclick="SeleccionarTab(posicionBarra - 1);" id="btnAnterior" disabled="disabled"><i class="fas fa-arrow-left mr-2"></i>Anterior</button>
                        <button type="button" class="btn btn-primary waves-effect waves-themed ml-3" onclick="SeleccionarTab(posicionBarra + 1);" id="btnSiguiente"><i class="fas fa-arrow-right mr-2"></i>Siguiente</button>
                    </div>

                    <div data-visible="SeccionFin" style="display:none">
                        <div id="divValidarFormSectionFin">
                            <button type="button" id="btnValidarFormSectionFin" class="btn btn-primary waves-effect waves-themed ml-3 ml-auto float-right" onclick="buttonGuardar();"><i class="fas fa-save mr-2"></i>Guardar</button>
                        </div>
                        <div id="divEnProcesoSectionFin" style="display:none">
                            <button class="btn btn-primary waves-effect waves-themed ml-3 ml-auto" type="button" disabled>
                                <span class="spinner-border spinner-border-sm mr-2" role="status" aria-hidden="true"></span>
                                Procesando...
                            </button>
                        </div>
                    </div>

                </div>

                <div id="notEditable" class="col-12" style="display: none;">
                    <div class="alert alert-danger d-flex  m-0 py-2 col-12" role="alert" style="" data-bind="visible: !cybersegConnect()">
                        <div class="">
                            <span style="font-size:20px;"><i class="fal fa-exclamation-triangle"></i></span>
                        </div>
                        <div class="pt-2 fw-500 ml-4" style="font-size:14px;">
                            <span>
                                No se puede modificar una campaña que se encuentra en curso y habilitada.
                            </span>
                        </div>


                    </div>
                </div>

            </div>


        </div>
    </div>
</div>

