@*@Scripts.Render("~/Scripts/Models/Campanias/SectionCampania/TipoCampania/CampaniaMail.js")*@

<div class="panel h-100 mb-0" style="display: none !important;" id="CampaniaMail" data-bind="visible:visibleTipoCampania()">
    

    <div class="row">
        <div class="col-12">
            <div class="m-2">
                <h3 class="col-12">
                    <strong>
                        <i class="fal mr-2 fs-xxl fa-envelope blue"></i>
                        Mail
                    </strong>
                    <small>Automatiza el envio de mails de tu aplicación.</small>
                </h3>

                <div class="col-12 mt-1">
                    <button class="btn btn-success m-0 divVisibleFalse" data-bind="visible:!visibleAgregar(), click:botonAgregar" style="display:none;"><i class="fal fa-plus mr-2"></i>Agregar campaña</button>
                    <button class="btn btn-danger m-0 divVisibleFalse" data-bind="visible:visibleAgregar(), click:botonCancelar" style="display:none;"><i class="fal fa-trash-alt mr-2"></i>Quitar campaña</button>

                    <button class="btn btn-outline-info mr-1 float-right disabled">Personalizable</button>
                    <button class="btn btn-outline-info mr-1 float-right disabled">Marketing mailing</button>
                    <button class="btn btn-outline-info mr-1 float-right disabled">Masivos</button>
                </div>

            </div>

        </div>

    </div>



    <div class="panel-container h-100" style="display: none !important;" data-bind="visible:visibleAgregar()">
        <form id="formValidarCampaniaMail" class="h-100" role="form">
            <div class="panel-content h-100 border-top">
                <div class="form-row">
                    <div class="col-6 mb-2">
                        <label class="form-label" for="txtAstunto">Asunto <span class="text-danger">*</span></label>
                        <input type="text" id="txtAstunto" class="form-control" required="required" placeholder="Asunto" data-bind="value: asunto" />
                        <div class="invalid-feedback">Campo obligatorio.</div>
                        <div class="valid-feedback">
                            Correcto!
                        </div>
                    </div>
                    <div class="col-6 mb-2">
                        <label class="form-label" for="txtMailOrigen">Mail origen <span class="text-danger">*</span></label>
                        <input type="email" id="txtMailOrigen" class="form-control" required="required" placeholder="Mail origen" data-bind="value: mailOrigen" />
                        <div class="invalid-feedback">Campo obligatorio.</div>
                        <div class="valid-feedback">
                            Correcto!
                        </div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="col-lg-6 col-md-12 col-sm-12 mb-2">
                        <label class="form-label" for="select-envioMail">Envío <span class="text-danger">*</span></label>
                        <select id="select-envioMail" data-placeholder="Seleccionar un envío..." data-allow-clear="true" class="form-control select-control" required="required" data-bind="options: tipoEnviosList , optionsText: 'Nombre', optionsValue: 'TipoEnvioId', value: tipoEnvioId, event:{ change: changeTipoEnvio }, valueAllowUnset: true"></select>
                        <div class="invalid-feedback">Campo obligatorio.</div>
                        <div class="valid-feedback">
                            Correcto!
                        </div>
                    </div>

                    <!-- ko if: tipoEnvioId() == 2 -->
                    <!-- ko foreach: diasSemanaList() -->
                    <div class="col mb-2">
                        <label class="form-label" data-bind="text:Text"></label>
                        <div class="custom-control custom-switch mt-1">
                            <input type="checkbox" data-bind="checked: Check, attr:{ id:DiaSemanaId + '_Mail' }" class="custom-control-input">
                            <label class="custom-control-label cursor-pointer" data-bind="attr:{ for:DiaSemanaId + '_Mail' }"></label>
                        </div>
                    </div>
                    <!-- /ko -->
                    <!-- /ko -->

                    <div class="col-lg-2 col-md-12 col-sm-12 mb-2" style="display:none;" data-bind="visible:tipoEnvioId() == 1 || tipoEnvioId() == 2">
                        <label for="txtHoraMail">Hora <span class="text-danger">*</span></label>
                        <input id="txtHoraMail" type="time" class="form-control" placeholder="Hora" data-bind="value: hora">
                        <div class="invalid-feedback">Campo obligatorio.</div>
                        <div class="valid-feedback">
                            Correcto!
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12 col-sm-12 mb-2" style="display:none;" data-bind="visible:tipoEnvioId() == 3">
                        <label for="txtDiaMail">Día <span class="text-danger">*</span></label>
                        <div class="input-group date">
                            <input id="txtDiaMail" type="text" class="form-control" placeholder="Día" autocomplete="off" data-bind="value: dia">
                            <div class="input-group-append">
                                <span class="input-group-text fs-xl">
                                    <i class="fal fa-calendar-alt"></i>
                                </span>
                            </div>
                            <div class="invalid-feedback">Campo obligatorio.</div>
                            <div class="valid-feedback">
                                Correcto!
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12 col-sm-12 mb-2" style="display:none;" data-bind="visible:tipoEnvioId() == 4">
                        <label for="txtAnualMail">Anual <span class="text-danger">*</span></label>
                        <div class="input-group date">
                            <input id="txtAnualMail" type="text" class="form-control" placeholder="Anual" autocomplete="off" data-bind="value: anual">
                            <div class="input-group-append">
                                <span class="input-group-text fs-xl">
                                    <i class="fal fa-calendar-alt"></i>
                                </span>
                            </div>
                            <div class="invalid-feedback">Campo obligatorio.</div>
                            <div class="valid-feedback">
                                Correcto!
                            </div>
                        </div>
                    </div>


                    <div class="col-lg-6 col-md-12 col-sm-12 mb-2" style="display:none;" data-bind="visible:tipoEnvioId() == 5">
                        <label for="txtUnicaVezMail">Unica vez <span class="text-danger">*</span></label>
                        <input id="txtUnicaVezMail" type="date" class="form-control" placeholder="Unica vez" data-bind="value: unicaVez">
                        <div class="invalid-feedback">Campo obligatorio.</div>
                        <div class="valid-feedback">
                            Correcto!
                        </div>
                    </div>
                </div>
                <div class="form-row h-100">
                    <div class="col-12 mb-2">
                        <label class="form-label" for="eg-dark-theme-mail">Generar mail <span class="text-danger">*</span></label>
                        <div id="eg-dark-theme-mail" class="h-100"  data-bind="froala: ''"></div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>