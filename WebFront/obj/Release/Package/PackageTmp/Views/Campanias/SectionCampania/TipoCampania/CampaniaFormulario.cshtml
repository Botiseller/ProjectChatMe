@*@Scripts.Render("~/Scripts/Models/Campanias/SectionCampania/TipoCampania/CampaniaFormulario.js")*@

<div class="panel h-100 mb-0" style="display: none !important;" id="CampaniaFormulario" data-bind="visible:visibleTipoCampania()">
    
    <div class="row">
        <div class="col-12">
            <div class="m-2">
                <h3 class="col-12">
                    <strong>
                        <i class="fal mr-2 fs-xxl fa-money-check blue"></i>
                        Formulario
                    </strong>
                    <small>Generá un formulario para pedir información a tus usuarios y asì completar tus bases de datos.</small>
                </h3>

                <div class="col-12 mt-1">
                    <button class="btn btn-success m-0 divVisibleFalse" data-bind="visible:!visibleAgregar(), click:botonAgregar" style="display:none;"><i class="fal fa-plus mr-2"></i>Agregar campaña</button>
                    <button class="btn btn-danger m-0 divVisibleFalse" data-bind="visible:visibleAgregar(), click:botonCancelar" style="display:none;"><i class="fal fa-trash-alt mr-2"></i>Quitar campaña</button>

                    <button class="btn btn-outline-info mr-1 float-right disabled">Personalizable</button>
                    <button class="btn btn-outline-info mr-1 float-right disabled">Integración automática</button>
                    <button class="btn btn-outline-info mr-1 float-right disabled">Captura de datos</button>
                </div>

            </div>

        </div>

    </div>




    <div class="panel-container" style="display: none !important;" data-bind="visible:visibleAgregar()">
        <form id="formValidarCampaniaFormulario" role="form">
            <div class="panel-content h-100 border-top">
                <div class="form-row">
                    <div class="col-12">
                        <h4 class="form-label float-left" for="txtCampos">Campos </h4>
                        <div class="ml-auto mr-2 float-right">
                            <span class="text-center fs-xl fw-400" data-bind="html: formulariosList().length + ' Elementos'"></span>
                            <button style="display:none;" class="btn btn-outline-danger" data-bind="visible: formulariosEliminarList().length > 0,click:buttonEliminarFormulario"><i class="fal fa-trash-alt mr-2"></i>Eliminar<span class="badge badge-icon pos-top pos-right" data-bind="text: formulariosEliminarList().length"></span></button>
                        </div>
                    </div>
                </div>

                <div class="form-row border-bottom">

                    <div class="col-12">

                        <div class="row" data-bind="visible:formulariosList().length" style="display:none;">
                            <div class="col-12 mb-2">
                                <div class="d-flex">
                                    <div class="col-4">
                                        <label class="fs-xl">Nombre <span class="text-danger">*</span></label>
                                    </div>
                                    <div class="col-4">
                                        <label class="fs-xl">Tipo de dato <span class="text-danger">*</span></label>
                                    </div>
                                    <div class="col">
                                        <label class="fs-xl">Obligatorio</label>
                                    </div>
                                </div>
                                <!-- ko foreach: { data:  formulariosList(), as: 'formulario' } -->
                                <div class="d-flex mb-3">
                                    <div class="col-4 fila-HoverDnone AligneCenter">
                                        <div class="custom-control custom-checkbox position-absolute" data-bind="visible:formulario.VisibleSelected" style="display:none;">
                                            <input type="checkbox" class="custom-control-input inputActiveCheckbox" data-bind="click: formulario.SeleccionarFila, checked:formulario.Selected, attr: { id: 'chkSelected-' +  formulario.CampoId() }">
                                            <label class="custom-control-label cursor-pointer" data-bind="attr: { for: 'chkSelected-' + formulario.CampoId() }"></label>
                                        </div>
                                        <input type="text" required="required" data-bind="value:formulario.Nombre" class="form-control form-control-sm ml-4 col-11 border-0 cortarTextoUnRenglon estiloInputSubtitulo estiloInputTareas bg-fondoOscuro" placeholder="Nombre" maxlength="250">
                                    </div>
                                    <div class="col-4 fila-HoverDnone AligneCenter">
                                        <select data-allow-clear="false" class="form-control " required="required" data-bind="options: formulario.TiposDatosList, optionsText: 'Nombre', optionsValue: 'TipoDatoId', value: formulario.TipoDato, attr:{id:CampoId()}"></select>
                                    </div>
                                    <div class="col fila-HoverDnone">
                                        <div class="custom-control custom-switch AligneCenter">
                                            <input type="checkbox" data-bind="checked: formulario.Obligatorio, attr: { id: 'switchSabado-' + formulario.CampoId() }" class="custom-control-input">
                                            <label class="custom-control-label cursor-pointer" data-bind="attr: { for: 'switchSabado-' + formulario.CampoId() }"></label>
                                        </div>
                                    </div>
                                </div>
                                <!-- /ko -->
                            </div>
                        </div>

                        <nav class="row pb-5">

                            <div class="col-12">
                                <button type="button" class="btn btn-outline-info divVisibleFalse" data-bind="click:buttonAgregarFormulario"><i class="fal mr-2 fa-plus"></i>Elemento nuevo</button>
                            </div>
                        </nav>

                    </div>

                </div>


                <div class="form-row border-bottom pt-2">
                    <div class="col-12 mb-2">
                        <h4 class="form-label w-100 mb-3">Estilo<a href="https://files.botiseller.com/templates/capaigneformstyle.css" target="_blank" download class="btn btn-outline-info ml-3">Descargar template</a></h4>
                        <i class="fas fa-trash-alt red ml-1 cursor-pointer has-tooltip divVisibleFalse" style="display:none;" data-bind="visible:visbleArchivoEliminar(),click:botonArchivoEliminar" data-toggle="tooltip" title="Eliminar archivo"></i>

                        <blockquote class="box-placeholder text-center position-relative p-2  ml-2 mb-0">
                            <i class="fas fa-cloud-download-alt fa-5x"></i>
                            <br>
                            <strong class="w-100 mb-0" data-bind="text:archivoTexto()"></strong>
                            <i class="fas fa-cloud-download cursor-pointer position-relative" style="display:none;z-index:9" title="Descargar archivo" data-toggle="tooltip" data-bind="click:botonDescargarArchivoSubido,visible:visbleArchivoEliminar()"></i>
                            <input id="inputFileCssFormulario" type="file" accept=".css" name="files" class="has-tooltip divVisibleFalse">
                        </blockquote>

                    </div>
                </div>

                <div class="form-row pt-2">
                    <div class="col-12">
                        <h4 class="form-label" for="txtURLformularios">URL <span class="text-danger">*</span> </h4>
                        <input type="text" id="txtURLformularios" class="form-control" required="required" placeholder="URL" data-bind="value: url" disabled />
                        <div class="invalid-feedback">Campo obligatorio.</div>
                        <div class="valid-feedback">
                            Correcto!
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>