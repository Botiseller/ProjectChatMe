@*@Scripts.Render("~/Scripts/Models/Campanias/SectionCampania/TipoCampania/CampaniaWhatsappTemplate.js")*@

<div class="panel h-100 mb-0" style="display: none !important;" id="CampaniaWhatsappTemplate" data-bind="visible:visibleTipoCampania()">
    <div class="row">
        <div class="col-12">
            <div class="m-2">
                <h3 class="col-12">
                    <strong>
                        <i class="fal mr-2 fs-xxl fab fa-whatsapp green"></i>
                        Whatsapp template
                    </strong>
                    <small>Usa un template aprobado por Meta para enviar mensajes masivos y automáticos a tus contactos.</small>
                </h3>

                <div class="col-12 mt-1">
                    <button class="btn btn-success m-0 divVisibleFalse" data-bind="visible:!visibleAgregar(), click:botonAgregar" style="display:none;"><i class="fal fa-plus mr-2"></i>Agregar campaña</button>
                    <button class="btn btn-danger m-0 divVisibleFalse" data-bind="visible:visibleAgregar(), click:botonCancelar" style="display:none;"><i class="fal fa-trash-alt mr-2"></i>Quitar campaña</button>

                    <button class="btn btn-outline-info mr-1 float-right disabled">Alcance inmediato</button>
                    <button class="btn btn-outline-info mr-1 float-right disabled">Requiere template aprobado</button>
                    <button class="btn btn-outline-info mr-1 float-right disabled">Canal conversacional</button>
                </div>

            </div>

        </div>

    </div>
    <div class="panel-container" style="display: none !important;" data-bind="visible:visibleAgregar()">
        <form id="formValidarCampaniaWhatsappTemplate" role="form">
            <div class="panel-content row border-top">
                <div class="col-8" style="display: flex; flex-direction: column;">
                    <div class="form-row align-items-end">
                        <div class="col">
                            <label class="form-label" for="selectPlantilla">
                                Plantilla <span class="text-danger">*</span>
                            </label>

                            <select data-placeholder="Seleccionar una plantilla..." id="selectPlantilla" required="required" data-allow-clear="true" class="form-control select-control" data-bind=" options: plantillaList, optionsText: 'Mensaje', optionsValue: 'PlantillaId', value: plantilla, valueAllowUnset: true, event:{ change: changePlantilla }"></select>

                            <div class="invalid-feedback">Campo obligatorio.</div>
                            <div class="valid-feedback">Correcto!</div>
                        </div>

                        <div class="col-auto">
                            <a class="btn btn-outline-success" href="https://app.botiseller.com/Chat/Templates" target="_blank" style="margin-bottom: 2px;">
                                Agregar template
                            </a>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="col-lg-6 col-md-12 col-sm-12 mb-2">
                            <label class="form-label" for="select-envioTemplate">Envío <span class="text-danger">*</span></label>
                            <select id="select-envioTemplate" data-placeholder="Seleccionar un envío..." data-allow-clear="true" class="form-control select-control" required="required" data-bind="options: tipoEnviosList , optionsText: 'Nombre', optionsValue: 'TipoEnvioId', value: tipoEnvioId, event:{ change: changeTipoEnvio }, valueAllowUnset: true"></select>
                            <div class="invalid-feedback">Campo obligatorio.</div>
                            <div class="valid-feedback">
                                Correcto!
                            </div>
                        </div>

                        <div class="col-lg-2 col-md-12 col-sm-12 mb-2" style="display:none;" data-bind="visible:tipoEnvioId() == 1 || tipoEnvioId() == 2">
                            <label for="txtHoraTemplate">Hora <span class="text-danger">*</span></label>
                            <input id="txtHoraTemplate" type="time" class="form-control" placeholder="Hora" data-bind="value: hora">
                            <div class="invalid-feedback">Campo obligatorio.</div>
                            <div class="valid-feedback">
                                Correcto!
                            </div>
                        </div>

                        <div class="col-lg-6 col-md-12 col-sm-12 mb-2" style="display:none;" data-bind="visible:tipoEnvioId() == 3">
                            <label for="txtDiaTemplate">Día <span class="text-danger">*</span></label>
                            <div class="input-group date">
                                <input id="txtDiaTemplate" type="text" class="form-control" placeholder="Día" autocomplete="off" data-bind="value: dia">
                                <div class="input-group-append">
                                    <span class="input-group-text fs-xl">
                                        <i class="fal fa-calendar-alt"></i>
                                    </span>
                                </div>
                                <div class="invalid-feedback">Campo obligatorio.</div>
                                <div class="valid-feedback">
                                    Correcto!
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6 col-md-12 col-sm-12 mb-2" style="display:none;" data-bind="visible:tipoEnvioId() == 4">
                            <label for="txtAnualTemplate">Anual <span class="text-danger">*</span></label>
                            <div class="input-group date">
                                <input id="txtAnualTemplate" type="text" class="form-control" placeholder="Anual" autocomplete="off" data-bind="value: anual">
                                <div class="input-group-append">
                                    <span class="input-group-text fs-xl">
                                        <i class="fal fa-calendar-alt"></i>
                                    </span>
                                </div>
                                <div class="invalid-feedback">Campo obligatorio.</div>
                                <div class="valid-feedback">
                                    Correcto!
                                </div>
                            </div>
                        </div>


                        <div class="col-lg-6 col-md-12 col-sm-12 mb-2" style="display:none;" data-bind="visible:tipoEnvioId() == 5">
                            <label for="txtUnicaVezTemplate">Unica vez <span class="text-danger">*</span></label>
                            <input id="txtUnicaVezTemplate" type="date" class="form-control" placeholder="Unica vez" data-bind="value: unicaVez">
                            <div class="invalid-feedback">Campo obligatorio.</div>
                            <div class="valid-feedback">
                                Correcto!
                            </div>
                        </div>
                    </div>

                    <!-- ko if: tipoEnvioId() == 2 -->
                    <div class="form-row mb-2 ml-3">

                        <div class="col-12 d-flex">
                            <!-- ko foreach: diasSemanaList() -->
                            <div class="mr-2">
                                <label class="form-label" data-bind="text:Text"></label>
                                <div class="custom-control custom-switch mt-1">
                                    <input type="checkbox" data-bind="checked: Check, attr:{ id:DiaSemanaId + '_Template' }" class="custom-control-input">
                                    <label class="custom-control-label cursor-pointer" data-bind="attr:{ for:DiaSemanaId + '_Template' }"></label>
                                </div>
                            </div>
                            <!-- /ko -->
                        </div>

                    </div>
                    <!-- /ko -->

                    <div class="form-row mt-3" data-bind="visible:variablesList().length" style="display:none;">
                        <div class="col-12">
                            <h3 class="m-0">
                                Párametros de Plantilla
                                <small class="m-0">Completa los datos requeridos para personalizar el envio de tu plantilla</small>
                            </h3>
                        </div>
                    </div>

                    <div class="form-row ml-2 mb-2" data-bind="foreach: { data: variablesList, as: 'variable' }, visible:variablesList().length" style="display:none;">
                        <div class="col-xs-6 col-sm-6 col-md-4 col-lg-4">
                            <label class="form-label" data-bind="attr:{ for: variable.VariableId() }"><span data-bind="html: variable.Nombre()"></span> <span class="text-danger">*</span></label>
                            <select data-placeholder="Seleccionar un parametro..." required="required" data-allow-clear="true" class="form-control select-control-lista" data-bind="options: ParametrosList , optionsText: 'Nombre', optionsValue: 'ParametroId', value: ParametroId, valueAllowUnset: true, attr:{ id: variable.VariableId() }"></select>
                            <div class="invalid-feedback">Campo obligatorio.</div>
                            <div class="valid-feedback">
                                Correcto!
                            </div>
                        </div>
                    </div>




                    <div style="display: flex; flex-direction: column; height: 100%;">
                        <div class="panel mt-2 ml-1 px-3 py-4" style="margin-top: auto !important;">
                            <div class="row">
                                <div class="fab fa-whatsapp green fa-4x col-1 fa-3x"></div>
                                <div class="col-11 fa-2x">Whatsapp tempalte</div>
                            </div>
                            <div class="row">
                                <p class="col-12 mt-3" style="font-size:13px;">
                                    Los <b>WhatsApp Templates</b> son mensajes predefinidos y aprobados por Meta que te permiten iniciar conversaciones de forma automática y segura.
                                    Son ideales para campañas masivas, notificaciones importantes y comunicaciones con alto impacto, asegurando una excelente tasa de entrega y una experiencia profesional para tus clientes.
                                </p>
                            </div>
                        </div>
                    </div>


                </div>


                <div class="col-4 d-flex justify-content-center" data-bind="visible:visibleMensaje()" style="display:none;">
                    <div class="">
                        <div class="col-12 mb-2">
                            <div class="wa-phone-preview">
                                <div class="wa-phone__frame">
                                    <div class="wa-phone__notch"></div>

                                    <!-- Header -->
                                    <div class="wa-header">
                                        <div class="wa-avatar">B</div>
                                        <div class="wa-header-text">
                                            <div class="wa-header-title">Botiseller</div>
                                            <div class="wa-header-subtitle">Empresa verificada</div>
                                        </div>
                                    </div>

                                    <!-- Chat -->
                                    <div class="wa-chat">
                                        <div class="wa-message">
                                            <div class="wa-message-text" id="waMessageText" data-bind="html:textoMensaje()"></div>
                                            @*<div class="wa-buttons" id="waButtons" data-bind="foreach: plantilla()?.Botones()">
                                        <div class="wa-btn" data-bind="html:boton"></div>
                                    </div>*@
                                        </div>

                                    </div>

                                    <!-- Input -->
                                    <div class="wa-input">
                                        <span class="fal fa-smile"></span>
                                        <div class="wa-input-box">Mensaje</div>
                                        <span class="fa fa-microphone"></span>
                                        <span class="wa-send fa fa-arrow-right"></span>
                                    </div>
                                </div>
                            </div>



                        </div>
                    </div>
                </div>

            </div>


            



        </form>
    </div>
</div>


