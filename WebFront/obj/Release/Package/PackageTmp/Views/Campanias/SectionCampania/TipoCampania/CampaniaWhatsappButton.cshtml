@*@Scripts.Render("~/Scripts/Models/Campanias/SectionCampania/TipoCampania/CampaniaWhatsappButton.js")*@


<style>
    #SectionCampaniaPanel .code-example {
        background: #1e1e1e;
        border-radius: 6px;
        padding: 16px;
        font-family: Consolas, 'Courier New', monospace;
        font-size: 13px;
        color: #d4d4d4;
        position: relative;
        max-width: 100%;
        height: 250px;
        overflow-y: scroll;
    }

    #SectionCampaniaPanel .code-example-botton-copy {
        position: absolute;
        top: 10px;
        right: 10px;
        background: #2d2d2d;
        border: 1px solid #3c3c3c;
        color: #cccccc;
        font-size: 12px;
        padding: 4px 8px;
        border-radius: 4px;
        cursor: pointer;
    }

    #SectionCampaniaPanel .code-example pre {
        margin: 0;
        white-space: pre-wrap;
        line-height: 1.5;
        color: white;
    }

</style>


<div class="panel h-100 mb-0" style="display: none !important;" id="CampaniaWhatsappButton" data-bind="visible:visibleTipoCampania()">
    
    <div class="row">
        <div class="col-12">
            <div class="m-2">
                <h3 class="col-12">
                    <strong>
                        <i class="fal mr-2 fs-xxl fab fa-whatsapp green"></i>
                        Whatsapp button
                    </strong>
                    <small>Generá un botón con el icono de whatsapp para poner en tu web y rdirigir al cliente a Whatsapp. Luego contabiliza cuantos clicks tuviste y cuantas conversaciones comenzaste.</small>
                </h3>

                <div class="col-12 mt-1">
                    <button class="btn btn-success m-0 divVisibleFalse" data-bind="visible:!visibleAgregar(), click:botonAgregar" style="display:none;"><i class="fal fa-plus mr-2"></i>Agregar campaña</button>
                    <button class="btn btn-danger m-0 divVisibleFalse" data-bind="visible:visibleAgregar(), click:botonCancelar" style="display:none;"><i class="fal fa-trash-alt mr-2"></i>Quitar campaña</button>

                    <button class="btn btn-outline-info mr-1 float-right disabled">Baja fricción</button>
                    <button class="btn btn-outline-info mr-1 float-right disabled">Genera trafico</button>
                    <button class="btn btn-outline-info mr-1 float-right disabled">Canal conversacional</button>
                </div>

            </div>

        </div>

    </div>

    <div class="panel-container" style="display: none !important;" data-bind="visible:visibleAgregar()">
        <form id="formValidarCampaniaWhatsappButton" role="form">
            <div class="panel-content h-100 border-top">
                <div class="form-row">
                    <div class="col-12 mb-2">
                        <label class="form-label" for="txtMensajeButton">Mensaje <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="txtMensajeButton" placeholder="Mensaje" required="required" data-bind="value: mensaje,event: { 'keyup': cambiarTextoMensaje }">
                        <div class="invalid-feedback">Campo obligatorio.</div>
                        <div class="valid-feedback">
                            Correcto!
                        </div>
                    </div>
                </div>
                <div class="form-row">
                    <div class="col-5 mb-2">
                        <label class="form-label" for="select-CodPaises">País <span class="text-danger">*</span></label>
                        <select id="select-CodPaises" data-placeholder="País" data-allow-clear="true" required="required" class="form-control select-control" data-bind="options: codigosPaisesLista, optionsText: 'Descripcion',optionsValue: 'Id', value: codPais, event:{ change: cambiarTelefono}, valueAllowUnset: true"></select>
                        <div class="invalid-feedback">Campo obligatorio.</div>
                        <div class="valid-feedback">
                            Correcto!
                        </div>
                    </div>
                    @*<div class="col-2 mb-2">
                        <label class="form-label" for="txtCodCiudad">Area <span class="text-danger">*</span> </label>
                        <input type="text" class="form-control" id="txtCodCiudad" placeholder="Area" required="required" data-bind="value: codCiudad, event: { 'keyup': cambiarTelefono }" maxlength="3">
                        <div class="invalid-feedback">Campo obligatorio.</div>
                        <div class="valid-feedback">
                            Correcto!
                        </div>
                    </div>*@
                    <div class="col-5 mb-2">
                        <label class="form-label" for="txtNombre">Teléfono <span class="text-danger">*</span> </label>
                        <input type="text" class="form-control" id="txtTelefono" placeholder="Teléfono" required="required" data-bind="value: telefono,event: { 'keyup': cambiarTelefono }" maxlength="50">
                        <div class="invalid-feedback">Campo obligatorio.</div>
                        <div class="valid-feedback">
                            Correcto!
                        </div>
                    </div>
                </div>
                <div class="form-row">
                    <div class="col-12 mb-2">
                        <h3>
                            Codigo generado
                        </h3>

                        <div class="row">
                            <div class="col-10">
                                <div class="code-example">

                                    <button class="code-example-botton-copy" data-bind="click: function() {navigator.clipboard.writeText(snippetHtml());}">
                                        Copiar script
                                    </button>

                                    <pre id="codeContent">
&lt;!-- START Botón WhatsApp --&gt;
&lt;div style="position:relative;"&gt;
    &lt;target="_blank"
            title="WhatsApp"
            style="position:absolute;
                bottom:16px;
                right:16px;
                display:inline-flex;
                align-items:center;
                justify-content:center;
                width:56px;
                height:56px;
                background-color:#25D366;
                border-radius:50%;
