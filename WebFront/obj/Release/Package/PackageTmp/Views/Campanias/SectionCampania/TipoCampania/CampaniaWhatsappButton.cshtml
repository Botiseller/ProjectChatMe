            onmouseover="this.style.backgroundColor='#1ebe5d'"
            onmouseout="this.style.backgroundColor='#25D366'"&gt;
            &lt;svg xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 32 32"
                    width="34"
                    height="34"
                    fill="#ffffff"&gt;
