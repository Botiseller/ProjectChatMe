@using System.Web.Optimization

@{
    ViewBag.Title = "Campañas";
}

@section scripts
{
    <script type="text/javascript">
        $(".subheader-icon.fal").addClass("fal fa-megaphone");
    </script>
    @Scripts.Render("~/Scripts" + Common.Utility.Helper.getVersionScript() + "/Models/Segmentos/CrearSegmentos.js")
    @Scripts.Render("~/Scripts" + Common.Utility.Helper.getVersionScript() + "/Models/Campanias/SectionCampania/SectionCampania.js")
    @Scripts.Render("~/Scripts" + Common.Utility.Helper.getVersionScript() + "/Models/Campanias/SectionDatosGenerales/SectionDatosGenerales.js")

    @Scripts.Render("~/Scripts" + Common.Utility.Helper.getVersionScript() + "/Models/Campanias/SectionCampania/TipoCampania/CampaniaBanner.js")
    @Scripts.Render("~/Scripts" + Common.Utility.Helper.getVersionScript() + "/Models/Campanias/SectionCampania/TipoCampania/CampaniaFormulario.js")
    @Scripts.Render("~/Scripts" + Common.Utility.Helper.getVersionScript() + "/Models/Campanias/SectionCampania/TipoCampania/CampaniaMail.js")
    @Scripts.Render("~/Scripts" + Common.Utility.Helper.getVersionScript() + "/Models/Campanias/SectionCampania/TipoCampania/CampaniaQR.js")
    @Scripts.Render("~/Scripts" + Common.Utility.Helper.getVersionScript() + "/Models/Campanias/SectionCampania/TipoCampania/CampaniaWhatsappButton.js")
    @Scripts.Render("~/Scripts" + Common.Utility.Helper.getVersionScript() + "/Models/Campanias/SectionCampania/TipoCampania/CampaniaWhatsappTemplate.js")

    @Scripts.Render("~/Scripts" + Common.Utility.Helper.getVersionScript() + "/Models/Campanias/SectionSegmentos/SectionSegmentos.js")
    @Scripts.Render("~/Scripts" + Common.Utility.Helper.getVersionScript() + "/Models/Campanias/SectionFin/SectionFin.js")
    @Scripts.Render("~/Scripts" + Common.Utility.Helper.getVersionScript() + "/Models/Campanias/CrearCampanias.js")
    @Scripts.Render("~/Scripts" + Common.Utility.Helper.getVersionScript() + "/Models/Campanias/Campanias.js")



}


<div id="Campanias">
    <div class="panel mb-0">
        <div class="panel-container">
            <nav class="navbar navbar-expand-lg navbar-light border-bottom">
                <ul class="navbar-nav mr-auto col-lg-4">
                    <li class="nav-item w-100">
                        <div class="input-group rounded">
                            <input type="text" class="form-control" placeholder="Buscar por nombre campañia..." role="search" id="txtBuscar" maxlength="120">
                            <div class="input-group-append">
                                <button class="btn btn-primary" type="button"><i class="fal fa-search"></i></button>
                            </div>
                        </div>
                    </li>
                </ul>

                <button class="navbar-toggler mt-1 mb-1" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="true" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav mr-auto">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle fs-xl text-truncate text-truncate-lg text-info" href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                Estados
                            </a>
                            <div class="dropdown-menu fadeindown">
                                <div class="dropdown-item">
                                    <div class="custom-control custom-checkbox">
                                        <input type="radio" class="custom-control-input" value="Todas" name="rdEstado" id="checkTodas" data-bind="checked: checkEstado,click: buttonCheck">
                                        <label class="custom-control-label cursor-pointer" for="checkTodas">Todas</label>
                                    </div>
                                </div>
                                <div class="dropdown-divider m-0"></div>
                                <div class="dropdown-item">
                                    <div class="custom-control custom-checkbox">
                                        <input type="radio" class="custom-control-input" value="EnCurso" name="rdEstado" id="checkEnCurso" data-bind="checked: checkEstado,click: buttonCheck">
                                        <label class="custom-control-label cursor-pointer" for="checkEnCurso">En curso</label>
                                    </div>
                                </div>
                                <div class="dropdown-item">
                                    <div class="custom-control custom-checkbox">
                                        <input type="radio" class="custom-control-input" value="Deshabilitada" name="rdEstado" id="checkDeshabilitada" data-bind="checked: checkEstado,click: buttonCheck">
                                        <label class="custom-control-label cursor-pointer" for="checkDeshabilitada">Deshabilitada</label>
                                    </div>
                                </div>
                                <div class="dropdown-item">
                                    <div class="custom-control custom-checkbox">
                                        <input type="radio" class="custom-control-input" value="Terminada" name="rdEstado" id="checkTerminada" data-bind="checked: checkEstado,click: buttonCheck">
                                        <label class="custom-control-label cursor-pointer" for="checkTerminada">Terminada</label>
                                    </div>
                                </div>
                                <span class="chevron"></span>
                            </div>
                        </li>
                        <li class="nav-item hidden-md-down">
                            <a class="nav-link fs-xl text-truncate text-truncate-lg text-info" style="color: #e0e0e0 !important;">|</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle fs-xl text-truncate text-truncate-lg text-info" href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                Canales
                            </a>
                            <div class="dropdown-menu fadeindown" data-bind="foreach:tipoCampaniasList">
                                <div class="dropdown-item">
                                    <div class="custom-control custom-checkbox">
                                        <input type="checkbox" class="custom-control-input" data-bind="checked: Check,click: $root.buttonCheck, attr:{ id: TipoCampaniaId()}">
                                        <label class="custom-control-label cursor-pointer" data-bind="text:Nombre(), attr:{ for: TipoCampaniaId()}"></label>
                                    </div>
                                </div>
                                <span class="chevron"></span>
                            </div>
                        </li>
                    </ul>
                </div>

                <div class="ml-auto">
                </div>
            </nav>
            <div class="overflow-auto" style="height: calc(100vh - calc(150px + 50px))">
                <div class="panel-content">
                    <div class="row">
                        <div class="col-sm-6 col-xl-3 mb-2" data-bind="click:buttonCrearCampania">
                            <div class="divCard">
                                <em class="fa fa-megaphone fa-4x"></em>
                                <h3>Crear campaña</h3>
                                <span>Diseña diferentes campañas para mentener comunicados a tus clientes con tu negocios.</span>
                            </div>
                        </div>

                        <!-- ko foreach: { data: campaniasList(), as: 'campania' }  -->
                        <div class="col-sm-6 col-xl-3 mb-2" data-bind="click:campania.ButtonCrearCampania,visible:$root.campaniasList().length" style="display:none;">
                            <div class="divCard divCardEdit">
                                <div class="d-flex w-100">
                                    <div class="col-11 text-left">
                                        <h2>
                                            <em class="fa fa-megaphone float-left mr-1"></em>
                                            <span data-bind="text:campania.Nombre()"></span>
                                        </h2>
                                    </div>
                                    <div class="col">
                                        <input type="checkbox" data-bind="checked: campania.Habilitado(), click:campania.ButtonHabilitar,attr: { 'data-original-title': campania.Habilitado() ? 'Deshabilitar' : 'Habilitar' }" class="cursor-pointer has-tooltip" data-placement="top" data-toggle="tooltip" style="height: 20px !important; width: 20px !important;">
                                    </div>
                                </div>
                                <label class="ml-4" data-bind="text:campania.FechaStr()" style="font-size:12px;"></label>
                                <!-- ko if: campania.CampaniasSegmentosNombre() != null -->
                                <label class="ml-4" data-bind="text:campania.CampaniasSegmentosNombre()" style="font-size:12px;"></label>
                                <!-- /ko -->
                                <div class="mt-2 pos-bottom mb-2" style="display:none;" data-bind="visible:campania.CampaniasPublicidadesList().length">
                                    <h1 class="text-left" style="font-size:14px;">Medios conectados</h1>

                                    <!-- ko foreach: { data: campania.CampaniasPublicidadesList(), as: 'tipoCampania' }  -->
                                    <div class="mx-4 float-left has-tooltip" data-bind="attr: { title:  tipoCampania.NombreStr() }">
                                        <!-- ko if: tipoCampania.TipoCampania() == new Enums().TipoCampania.CampaniaWhatsappTemplate || tipoCampania.TipoCampania() == new Enums().TipoCampania.CampaniaWhatsappButton -->
                                        <i class="fab fa-whatsapp fa-2x color-whatsapp"></i>
                                        <!-- /ko -->
                                        <!-- ko if: tipoCampania.TipoCampania() == new Enums().TipoCampania.CampaniaFormulario -->
                                        <i class="fa fa-file-alt fa-2x color-form"></i>
                                        <!-- /ko -->
                                        <!-- ko if: tipoCampania.TipoCampania() == new Enums().TipoCampania.CampaniaBanner -->
                                        <span class="fa-2x color-banner" style="min-height:inherit !important;">&lt;/&gt;</span>
                                        <!-- /ko -->
                                        <!-- ko if: tipoCampania.TipoCampania() == new Enums().TipoCampania.CampaniaQR -->
                                        <i class="fas fa-qrcode fa-2x color-qr"></i>
                                        <!-- /ko -->
                                        <!-- ko if: tipoCampania.TipoCampania() == new Enums().TipoCampania.CampaniaMail -->
                                        <i class="fas fa-envelope fa-2x color-mail"></i>
                                        <!-- /ko -->
                                    </div>
                                    <!-- /ko -->
                                </div>
                            </div>
                        </div>
                        <!-- /ko -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section modalshtml
{
    @{
        Html.RenderPartial("~/Views/Campanias/CrearCampanias.cshtml");
    }
}

