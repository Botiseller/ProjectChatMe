    #SectionSegmentoPanel .page {
        max-width: 1180px;
        margin: 0 auto;
        padding: 26px 22px 90px;
    }

    /* Title */
    #SectionSegmentoPanel .page-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 6px 0;
        font-size: 22px;
        font-weight: 700;
    }

    #SectionSegmentoPanel.page-subtitle {
        margin: 0 0 18px 0;
        color: var(--muted);
        font-size: 13px;
    }

    /* Cards */
    #SectionSegmentoPanel.card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: 0 10px 26px rgba(23,18,43,.06);
        flex-direction: row !important;
    }

    /* Intro banner */
    #SectionSegmentoPanel.intro {
        padding: 22px 22px;
        display: flex;
        gap: 18px;
        align-items: flex-start;
        background: linear-gradient(s180deg,#ffffff 0%, #fbfaff 100%);
        margin-bottom: 18px;
    }

    #SectionSegmentoPanel.intro-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: rgba(111,75,216,.10);
        color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex: 0 0 auto;
    }

    #SectionSegmentoPanel.intro h2 {
        margin: 0;
