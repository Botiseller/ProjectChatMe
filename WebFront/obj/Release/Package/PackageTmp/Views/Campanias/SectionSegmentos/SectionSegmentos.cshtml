<div id="SectionSegmentos">
    <form id="formValidarSegmentos" role="form">

        <div class="grid">

            <div class="panel">
                <h4 style="font-size: 16px; font-weight: 600;">Segmentos disponibles</h4>
                <p>Elige un segmento existente o crea uno nuevo sin salir del flujo.</p>

                <div class="searchRow">
                    <div class="search">
                        <input id="search" class="form-control mb-2 mt-2" type="search" placeholder="Buscar segmento...">
                    </div>

                </div>

                <div class="list">

                    <div class="list-group segment-list" data-bind="foreach: segmentosList">

                        <div class="segCard" data-bind=" click: function(){ $parent.campaniaSegmentoId(CampaniaSegmentoId()) }, css: { active: $parent.campaniaSegmentoId() === CampaniaSegmentoId() } ">
                            <div class="segIcon" style="color:#2d8f66;background:rgba(60,207,145,.10);">
                                <i class="fas fa-regular fa-user"></i>
                            </div>

                            <div class="segMeta">
                                <p class="segName" data-bind=" text: Nombre().toUpperCase()"></p>
                                <p class="segInfo" data-bind=" text: Descripcion"></p>
                                <p class="segIco">
                                    <!-- ko if: IncluyeContacto -->
                                    <i class="fas fa-users"></i>
                                    <!-- /ko -->
                                    <!-- ko if: IncluyeLead -->
                                    <i class="fas fa-user"></i>
                                    <!-- /ko -->
                                </p>

                            </div>

                            <!-- ko if: $parent.campaniaSegmentoId() === CampaniaSegmentoId() -->
                            <span class="badge badgeOk"><i class="fas fa-check"></i> Seleccionado</span>
                            <!-- /ko -->


                        </div>

                    </div>

                </div>
            </div>

            <div class="side">

                <!-- Crear segmento -->
                <div class="actionCard">
                    <div class="d-flex">
                        <div class="actionIcon" style="color:#d35aa6;background:rgba(211,90,166,.10);float:left">
                            <i class="fas fa-filter"></i>
                        </div>

                        <div class="ml-4 float-right">
                            <h4>Crear nuevo segmento</span></h4>
                            <p>Define nuevas reglas para crear una lista dinámica.</p>
                        </div>


                    </div>


                    <div class="actions">
                        <button class="btnPrimary" type="button" data-bind="click:buttonAgregarSegmento">
                            <i class="fas fa-filter"></i> Crear segmento
                        </button>
                    </div>
                </div>

                <!-- Importar archivo -->
                <div class="actionCard">
                    <div class="w-100 d-flex">
                        <div class="actionIcon mr-3 float-left" style="color:var(--teal);background:rgba(35,185,183,.10)">
                            <i class="fas fa-cloud-upload"></i>

                        </div>
                        <div class="mr-3 float-right">
                            <h4>Importar archivo</h4>
                            <p>Sube un archivo Excel para crear una lista personalizada de tu segmento.</p>

                        </div>


                    </div>



                    <div class="alert alert-warning alert-dismissible fade show mb-0 p-2" style="border-radius:10px;">
                        <div class="d-flex align-items-center">
                            <div class="alert-icon ">
                                <i class="fas fa-info-circle"></i>
                            </div>
                            <div class="flex-1">
                                <span class="h4">
                                    Importación de segmento
                                </span>
                                <br>
                                Para importar un archivo es necesario tener encuenta cuales son las columnas necesarias.
                                <strong>Según los canales que has configurado, las columnas necesarias son:</strong>
                                <ul style="margin-bottom:0px;">
                                    <!-- ko foreach: columnasImportacionList -->
                                    <li data-bind="text: Columna()"></li>
                                    <!-- /ko -->
                                </ul>


                            </div>

                        </div>
                    </div>



                    <div class="actions">
                        <!-- Estado sin archivo -->
                        <span class="btn btn-success btnTeal fileinput-button has-tooltip cursor-pointer float-right mr-2 cursor-pointer" style="width:auto !important;">
                            <i class="fas fa-cloud-upload"></i>
                            <span>Subir archivo</span>
                            <input id="fileImportarDatos" type="file" accept=".xls,.xlsx" name="files" class="addFile has-tooltip">
                        </span>


                        <!-- Estado con archivo (ejemplo) -->
                        <!-- ko if: masterSectionSegmentosVM.archivoImportar() -->
                        <span class="filePill">
                            <i class="fas fa-file-excel"></i>
                            <span data-bind="text:nombreArchivo"></span>
                        </span>
                        <!-- /ko -->
                        <!-- ko if: datosImportacionList().length -->
                        <div class="filePill cursor-pointer">
                            <i class="fas fa-solid fa-check"></i>
                            <span data-bind="click: showImportacionList">Ver importación</span>
                        </div>
                        <!-- /ko -->

                    </div>

                    <!-- Resultado final del import (ejemplo) -->
                    <!-- ko if: datosImportacionList().length -->
                    <div class="okLine">
                        <i class="fas fa-solid fa-check"></i>
                        <span data-bind="text: datosImportacionList().length + ' contactos importados'"></span>
                    </div>
                    <!-- /ko -->
                    <!-- ko if: !ValidFileSegment() -->
                    <div class="failLine">
                        <i class="fas fa-solid fa-times"></i>
                        <span>El excel importado no respeta las columnas esperadas</span>
                    </div>
                    <!-- /ko -->



                </div>

            </div>

        </div>

        <div style="display:none;">
            <div class="row">
                <div class="col-12 border-bottom mb-2">
                    <h2 class="py-2 float-left">
                        <strong>Contactos importados</strong>
                    </h2>
