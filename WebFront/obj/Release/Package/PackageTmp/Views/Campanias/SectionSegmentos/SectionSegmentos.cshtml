    #SectionSegmentoPanel .toggle-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 12px;
        background: var(--soft);
        border: 1px solid var(--border);
        border-radius: 12px;
        font-size: 13px;
        color: #4f4f68;
        margin-top: 15px;
    }

    /* Switch */
    #SectionSegmentoPanel .switch {
        position: relative;
        display: inline-block;
        width: 44px;
        height: 24px;
        flex: 0 0 auto;
    }

        #SectionSegmentoPanel .switch input {
            display: none
        }

    #SectionSegmentoPanel .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: #cfcfe3;
        border-radius: 999px;
        transition: .2s;
    }

        #SectionSegmentoPanel .slider:before {
            content: "";
            position: absolute;
            height: 18px;
            width: 18px;
            left: 3px;
            top: 3px;
            background: white;
            border-radius: 50%;
            transition: .2s;
            box-shadow: 0 2px 6px rgba(0,0,0,.15);
        }

    #SectionSegmentoPanel .switch input:checked + .slider {
        background: #3ccf91
    }

        #SectionSegmentoPanel .switch input:checked + .slider:before {
            transform: translateX(20px)
        }

    /* Rules card */
    #SectionSegmentoPanel .rules {
        padding: 18px 18px 20px;
    }

    #SectionSegmentoPanel .rules-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 16px;
    }

    #SectionSegmentoPanel .rules-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 18px;
        font-weight: 700;
        margin: 0;
    }

        #SectionSegmentoPanel .rules-title .badge {
            width: 28px;
            height: 28px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(111,75,216,.10);
            color: var(--primary);
            font-size: 14px;
        }

    #SectionSegmentoPanel .tiles {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
    }

    #SectionSegmentoPanel .tile {
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 16px 16px;
        background: #fff;
        transition: .15s;
        min-height: 170px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

        #SectionSegmentoPanel .tile:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 22px rgba(23,18,43,.08);
            border-color: rgba(111,75,216,.35);
        }

    #SectionSegmentoPanel .tile-head {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 700;
        font-size: 16px;
    }

    #SectionSegmentoPanel .tile-ico {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--border);
        background: var(--soft);
        color: var(--primary);
    }

    #SectionSegmentoPanel .tile p {
        margin: 0;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.45;
        min-height: 40px;
    }

    #SectionSegmentoPanel .tile .control {
        margin-top: auto;
    }

    #SectionSegmentoPanel .tile select, .tile button {
        width: 100%;
        border-radius: 12px;
        padding: 10px 12px;
        font-size: 13px;
        border: 1px solid var(--border);
        outline: none;
        background: #fff;
        color: #4f4f68;
    }

    #SectionSegmentoPanel .tile button {
        background: rgba(111,75,216,.10);
        color: var(--primary);
        border-color: rgba(111,75,216,.30);
        cursor: pointer;
        font-weight: 600;
    }

        #SectionSegmentoPanel .tile button:hover {
            background: rgba(111,75,216,.14);
        }

    /* Footer */
    #SectionSegmentoPanel .footer {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(247,246,251,.85);
        backdrop-filter: blur(8px);
        border-top: 1px solid var(--border);
        padding: 12px 0;
    }

    #SectionSegmentoPanel .footer-inner {
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 22px;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }

    #SectionSegmentoPanel .AligneCenter {
        justify-content: flex-start;
    }
