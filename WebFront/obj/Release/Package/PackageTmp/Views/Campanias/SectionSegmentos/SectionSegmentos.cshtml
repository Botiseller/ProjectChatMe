        gap: 10px;
        box-shadow: 0 14px 24px rgba(111,75,216,.24);
    }

    #SectionSegmentoPanel .btnTeal {
        border: none;
        border-radius: 999px;
        padding: 12px 16px !important;
        background: linear-gradient(135deg, var(--teal), #49d7d5);
        color: #fff;
        font-weight: 800;
        font-size: 13px;
        cursor: pointer !important;
        display: inline-flex;
