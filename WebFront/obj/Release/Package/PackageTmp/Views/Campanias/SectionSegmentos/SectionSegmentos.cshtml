            font-size: 26px;
            font-weight: 700;
            margin: 0;
        }

            #SectionSegmentoPanel .head .title .ico {
                width: 42px;
                height: 42px;
                border-radius: 14px;
                background: rgba(111,75,216,.12);
                color: var(--primary);
                display: flex;
                align-items: center;
                justify-content: center;
