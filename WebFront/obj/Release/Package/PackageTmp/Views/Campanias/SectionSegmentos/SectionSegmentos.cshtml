        color: #0e6f6e;
        font-weight: 800;
        font-size: 13px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    #SectionSegmentoPanel .okLine {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #1f7b57;
        font-weight: 700;
        font-size: 13px;
        margin-top: 8px;
    }

        #SectionSegmentoPanel .okLine i {
            width: 22px;
            height: 22px;
            border-radius: 8px;
            background: rgba(60,207,145,.14);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--ok);
        }





    #SectionSegmentoPanel .failLine {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #c0392b;
        font-weight: 700;
        font-size: 13px;
        margin-top: 8px;
        background: rgba(255, 59, 48, 0.12);
