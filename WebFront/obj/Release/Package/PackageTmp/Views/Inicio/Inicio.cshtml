@using System.Web.Optimization
@using Common.Utility

@section scripts
{
    @Scripts.Render("~/Scripts" + Common.Utility.Helper.getVersionScript() + "/Models/Inicio/Inicio.js")
}

<div id="Inicio">
    <div class="row">
        <div class="col-12 mb-3">
            <h1 class="text-welcome">Buenas días, @(Helper.GetSessionData(Session)?.Usuario?.Nombre)</h1>
        </div>
    </div>
    <div class="row my-3 mb-3 divCardContent">
        <div class="col-sm-12 col-md-3 col-xl-3 mb-2">
            <div class="divCard" data-bind="click:buttonCampanias">
                <em class="fa fa-megaphone fa-4x"></em>
                <h3>Diseña campañas</h3>
                <span>Diseña diferentes campañas para mentener comunicados a tus clientes con tu negocios.</span>
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-xl-3 mb-2">
            <div class="divCard" data-bind="click:buttonSegmentos">
                <em class="fa fa-users fa-4x"></em>
                <h3>Segmentos</h3>
                <span>Segmenta tu cartera y asi poder realizar campañas de marketing mas precisas.</span>
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-xl-3 mb-2">
            <div class="divCard" data-bind="click:buttonSelling">
                <em class="fa fa-shopping-cart fa-4x"></em>
                <h3>Selling</h3>
                <span>Crear acciones de selling automatizadas para no perder niguna venta.</span>
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-xl-3 mb-2">
            <div class="divCard" data-bind="click:buttonDashboard">
                <em class="fa fa-tachometer-alt-slowest fa-4x"></em>
                <h3>Dashboard</h3>
                <span>Mira todos los informes de tu aplicación.</span>
            </div>
        </div>
    </div>

    <div class="divCardContent">
        <div class="row mb-3 ml-3 w-100 mt-5" style="display:none;" data-bind="visible:campaniasPublicidadesList().length">
            <div class="col-12 mb-2">
                <h1 class="text-welcome-secundario border-bottom">Medios conectados</h1>
            </div>
            <div class="col-12 ml-6">
                <!-- ko foreach: { data: campaniasPublicidadesList(), as: 'tipoCampania' }  -->
                <div class="mb-2 mx-4 float-left has-tooltip" data-bind="attr: { title:  tipoCampania.NombreStr() }">
                    <!-- ko if: tipoCampania.TipoCampania() == new Enums().TipoCampania.CampaniaWhatsappTemplate || tipoCampania.TipoCampania() == new Enums().TipoCampania.CampaniaWhatsappButton -->
                    <em class="fab fa-whatsapp fa-2x color-whatsapp"></em>
                    <!-- /ko -->
                    <!-- ko if: tipoCampania.TipoCampania() == new Enums().TipoCampania.CampaniaFormulario -->
                    <em class="fa fa-file-alt fa-2x color-form"></em>
                    <!-- /ko -->
                    <!-- ko if: tipoCampania.TipoCampania() == new Enums().TipoCampania.CampaniaBanner -->
                    <span class="fa-2x color-black color-banner" style="top: -6px; position: relative;">&lt;/&gt;</span>
                    <!-- /ko -->
                    <!-- ko if: tipoCampania.TipoCampania() == new Enums().TipoCampania.CampaniaQR -->
                    <em class="fas fa-qrcode fa-2x color-qr"></em>
                    <!-- /ko -->
                    <!-- ko if: tipoCampania.TipoCampania() == new Enums().TipoCampania.CampaniaMail -->
                    <em class="fas fa-envelope fa-2x color-mail"></em>
                    <!-- /ko -->
                </div>
                <!-- /ko -->
            </div>
        </div>
    </div>
</div>
