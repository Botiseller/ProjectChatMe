@using System.Web.Optimization

@{
    Layout = "~/Views/_BaseLayout.cshtml";
}

<div id="Feed" class="home-screen">

    <div class="home-search-row">
        <div class="search-input-wrap">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm10 2-4.35-4.35" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <input type="text" placeholder="Buscar empresas o rubros..." />
        </div>
    </div>

    <div class="section-header">
        <span class="section-label">Tus favoritas</span>
        <span class="section-hint">Tocá ☆ en una empresa para tenerla acá</span>
    </div>
    <div class="featured-rail">
        <button class="featured-card">
            <div class="avatar-circle" style="width:48px;height:48px;border-radius:50%;background:#6D3AF2;font-size:15px;">RE</div>
            <span class="featured-card__name">Rodo Electrodomésticos</span>
            <span class="featured-card__meta">2.5 km · Responde en ~2 min</span>
            <span class="ad-pill">Publicidad</span>
        </button>
        <button class="featured-card">
            <div class="avatar-circle" style="width:48px;height:48px;border-radius:50%;background:#2563EB;font-size:15px;">PE</div>
            <span class="featured-card__name">Parrilla El Fogón</span>
            <span class="featured-card__meta">1.8 km · Responde en ~4 min</span>
            <span class="ad-pill">Publicidad</span>
        </button>
        <button class="featured-card">
            <div class="avatar-circle" style="width:48px;height:48px;border-radius:50%;background:#F23D5C;font-size:15px;">FS</div>
            <span class="featured-card__name">Farmacia Salud+</span>
            <span class="featured-card__meta">10.8 km · Responde en ~1 min</span>
            <span class="ad-pill">Publicidad</span>
        </button>
    </div>

    <div class="section-header">
        <span class="section-label">Rubros</span>
        <button class="section-link">Ver todos</button>
    </div>
    <div class="cat-rail">
        <button class="cat-tile">
            <span class="cat-tile__icon">💇</span>
            <span class="cat-tile__name">Peluquería</span>
        </button>
        <button class="cat-tile">
            <span class="cat-tile__icon">🛋️</span>
            <span class="cat-tile__name">Muebles</span>
        </button>
        <button class="cat-tile">
            <span class="cat-tile__icon">👓</span>
            <span class="cat-tile__name">Óptica</span>
        </button>
        <button class="cat-tile">
            <span class="cat-tile__icon">🏠</span>
            <span class="cat-tile__name">Inmobiliaria</span>
        </button>
        <button class="cat-tile">
            <span class="cat-tile__icon">☕</span>
            <span class="cat-tile__name">Cafetería</span>
        </button>
        <button class="cat-tile cat-tile--more">
            <span class="cat-tile__icon">⋯</span>
            <span class="cat-tile__name">Ver todos</span>
        </button>
    </div>

    <div class="section-header">
        <span class="section-label">Empresas cerca tuyo</span>
        <button class="section-link">Ver en mapa</button>
    </div>
    <div class="biz-list">
        <div class="biz-row">
            <div class="avatar-circle" style="width:50px;height:50px;border-radius:14px;background:#F23D5C;font-size:16px;">PE</div>
            <div class="biz-row__info">
                <div class="biz-row__name">Peluquería Estilo</div>
                <div class="biz-row__meta">Peluquería · 0.3 km · Responde en ~1 h</div>
            </div>
            <span class="biz-row__status offline">Solo WhatsApp</span>
        </div>
        <div class="biz-row">
            <div class="avatar-circle" style="width:50px;height:50px;border-radius:14px;background:#6D3AF2;font-size:16px;">MD</div>
            <div class="biz-row__info">
                <div class="biz-row__name">Muebles del Centro <span class="badge-verified" title="Empresa verificada">✓</span></div>
                <div class="biz-row__meta">Muebles · 0.5 km · Responde en ~12 min</div>
            </div>
            <span class="biz-row__status connected">En Nexo</span>
        </div>
        <div class="biz-row">
            <div class="avatar-circle" style="width:50px;height:50px;border-radius:14px;background:#1FAE7A;font-size:16px;">IL</div>
            <div class="biz-row__info">
                <div class="biz-row__name">Inmobiliaria Llave</div>
                <div class="biz-row__meta">Inmobiliaria · 0.8 km · Responde en ~55 min</div>
            </div>
            <span class="biz-row__status offline">Solo WhatsApp</span>
        </div>
        <div class="biz-row">
            <div class="avatar-circle" style="width:50px;height:50px;border-radius:14px;background:#161122;font-size:16px;">CA</div>
            <div class="biz-row__info">
                <div class="biz-row__name">Café Aroma</div>
                <div class="biz-row__meta">Cafetería · 0.9 km · Responde en ~3 h</div>
            </div>
            <span class="biz-row__status offline">Solo WhatsApp</span>
        </div>
        <div class="biz-row">
            <div class="avatar-circle" style="width:50px;height:50px;border-radius:14px;background:#FFB020;font-size:16px;">ÓV</div>
            <div class="biz-row__info">
                <div class="biz-row__name">Óptica Visión <span class="badge-verified" title="Empresa verificada">✓</span></div>
                <div class="biz-row__meta">Óptica · 0.8 km · Responde en ~5 min</div>
            </div>
            <span class="biz-row__status connected">En Nexo</span>
        </div>
    </div>

</div>
