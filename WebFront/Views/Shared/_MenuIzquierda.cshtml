@using Common.Utility

<aside class="page-sidebar" id="_MenuIzquierda" style="margin-top: 4.125rem;">
    <!-- BEGIN PRIMARY NAVIGATION -->
    <nav id="js-primary-nav" class="primary-nav pt-4" role="navigation">
        <div class="nav-filter">
            <div class="position-relative">
                <input type="text" id="nav_filter_input" placeholder="Filtro menu" class="form-control" tabindex="0">
                <a href="#" onclick="return false;" class="btn-primary btn-search-close js-waves-off" data-action="toggle" data-class="list-filter-active" data-target=".page-sidebar">
                    <i class="fal fa-chevron-up"></i>
                </a>
            </div>
        </div>
        <div class="info-card">
  
            <div class="info-card-text">
                <a href="#" class="d-flex align-items-center text-white">
                    <span class="text-truncate text-truncate-sm d-inline-block" data-bind="text:sessionData.Usuario.Nombre + ' ' + sessionData.Usuario.Apellido">
                    </span>
                </a>
                <span class="d-inline-block text-truncate text-truncate-sm" data-bind="text:sessionData.Usuario.Mail"></span>
            </div>
      
                <img src="/../img/card-backgrounds/cover-2-lg.png" class="cover" alt="cover">
        
            <a href="#" onclick="return false;" class="pull-trigger-btn has-tooltip" data-action="toggle" data-class="list-filter-active" data-target=".page-sidebar" data-focus="nav_filter_input" title="Filtro menú">
                <i class="fal fa-angle-down"></i>
            </a>
        </div>
        <ul id="js-nav-menu" class="nav-menu mt-0">
            <li class="nav-title mt-0">Menú</li>
            <li pathname="/Inicio/Inicio">
                <a data-filter-tags="inicio" href="/Inicio/Inicio">
                    <i class="fas fa-home-alt"></i>
                    <span class="nav-link-text">Inicio</span>
                </a>
            </li>
           
        </ul>
        <div class="filter-message js-filter-message bg-success-600"></div>
    </nav>
    <!-- END PRIMARY NAVIGATION -->
</aside>
