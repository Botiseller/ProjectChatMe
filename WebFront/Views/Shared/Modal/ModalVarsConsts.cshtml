<div>
    <a href="#" class="cursor-pointer d-block variables  has-tooltip" title="Variables y Constantes" data-placement="top" data-toggle="dropdown">
        <i class="fal fal fa-font fa-2x color-black"></i>
    </a>

    <div class="dropdown-menu fadeinup variables pull-left" style="background: transparent; box-shadow: inherit">
        <div class="varsConst-container">
            <div class="varsConst-list">
                <div style="width:100%">
                    <div class="row pb-2 ">
                        <div class="input-group bg-white shadow-inset-2  float-left">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-transparent border-right-0">
                                    <i class="fal fa-search"></i>
                                </span>
                            </div>
                            <input type="text" class="filter-search form-control border-left-0 bg-transparent pl-0" placeholder="buscar por...">
                        </div>
                    </div>
                    <div class="row js-list-filter mt-2 filter-content" style="height:320px;" data-bind="foreach: variablesConsts()">
                        <div style="width: 50%; padding-left: 3%; padding-right: 3%; max-height: 20px;">
                            <div data-bind="attr: {'data-filter-tags': name.toLowerCase()}">
                                <button class="btnVarConsts btn-small btn-primary btn-pills p-1 pl-3 pr-3" type="button" data-bind="attr: {'data-value': '${' + name +  '}'}">
                                    <i class="fal fa-pi mr-2" style="color:white" data-bind="visible: type == 'const'"></i>
                                    <i class="fal fa-ad mr-2" style="color:white" data-bind="visible: type == 'var'"></i>
                                    <span data-bind="text: name"></span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




