@using Common.Utility

<header class="page-header m-0" role="banner" id="_Header" style="padding-left:0px;">
    <!-- we need this logo when user switches to nav-function-top -->
    <div>
        <a href="#" class="page-logo-link press-scale-down d-flex align-items-center position-relative pl-4" data-toggle="modal" data-target="#modal-shortcut">
            <img src="/../img/botiseller_wide.png"  alt="Botiseller" aria-roledescription="logo" style="width: auto;height: auto;">
        </a>
    </div>
    <!-- DOC: nav menu layout change shortcut -->
    <div class="hidden-md-down dropdown-icon-menu position-relative  d-none">
        <a href="#" class="header-btn btn js-waves-off cursor-pointer has-tooltip" data-placement="right" data-action="toggle" data-class="nav-function-hidden" title="Esconder Menú">
            <i class="ni ni-menu"></i>
        </a>
        <ul style="height: 5.25rem !important;">
            <li>
                <a href="#" class="btn js-waves-off cursor-pointer has-tooltip" data-placement="right" data-action="toggle" data-class="nav-function-minify" title="Minimizar Menú">
                    <i class="ni ni-minify-nav"></i>
                </a>
            </li>
            <li class="d-none">
                <a href="#" class="btn js-waves-off cursor-pointer has-tooltip" data-placement="right" data-action="toggle" data-class="nav-function-fixed" title="Bloquear Menú">
                    <i class="ni ni-lock-nav"></i>
                </a>
            </li>
        </ul>
    </div>
    <!-- DOC: mobile button appears during mobile width -->
    <div class="hidden-lg-up">
        <a href="#" class="header-btn btn press-scale-down" data-action="toggle" data-class="mobile-nav-on">
            <i class="ni ni-menu"></i>
        </a>
    </div>
    <div class="search d-none">
        <form class="app-forms hidden-xs-down" role="search" autocomplete="off" method="post" data-bind="submit: $root.buttonBuscadorGeneral">
            <input type="text" id="search-field" placeholder="Buscar Por Nombre, Apellido..." class="form-control" tabindex="1" data-bind="value:buscadorGeneral">
            <a href="#" onclick="return false;" class="btn-danger btn-search-close js-waves-off d-none" data-action="toggle" data-class="mobile-search-on">
                <i class="fal fa-times"></i>
            </a>
        </form>
    </div>
    <div class="ml-auto d-flex">
        <!-- activate app search icon (mobile) -->
        <div class="hidden-sm-up">
            <a href="#" class="header-icon has-tooltip" data-action="toggle" data-class="mobile-search-on" data-focus="search-field" title="Buscador General">
                <i class="fal fa-search"></i>
            </a>
        </div>

        <!-- app user menu -->
        <div>
            <a href="#" data-toggle="dropdown" class="header-icon d-flex align-items-center justify-content-center ml-2 cursor-pointer has-tooltip">
                @if (string.IsNullOrEmpty(Helper.GetSessionData(Session)?.Usuario?.Imagen))
                {
                    <span data-bind="attr: { class: 'iconoAvatar iconoAvatarSmall ' + sessionData.Usuario.Nombre.charAt(0).toLocaleLowerCase() }, text:sessionData.Usuario.Nombre.charAt(0).toLocaleUpperCase() + sessionData.Usuario.Apellido.charAt(0).toLocaleUpperCase()" style="display:block;line-height:normal;"></span>
                }
                else
                {
                    <img class="profile-image-md rounded-circle imgImagenSmall" src="@(Helper.GetSessionData(Session)?.Usuario?.Imagen)" style="display:block;" />
                }
            </a>
            <div class="dropdown-menu dropdown-menu-animated dropdown-lg">
                <div class="dropdown-header bg-trans-gradient d-flex flex-row py-4 rounded-top">
                    <div class="d-flex flex-row align-items-center mt-1 mb-1 color-white">
                        <span class="mr-2">
                            @if (string.IsNullOrEmpty(Helper.GetSessionData(Session)?.Usuario?.Imagen))
                            {
                                <span data-bind="attr: { class: 'iconoAvatar ' + sessionData.Usuario.Nombre.charAt(0).toLocaleLowerCase() }, text:sessionData.Usuario.Nombre.charAt(0).toLocaleUpperCase() + sessionData.Usuario.Apellido.charAt(0).toLocaleUpperCase()" style="display:block;"></span>
                            }
                            else
                            {
                                <img class="profile-image-md rounded-circle imgImagen" src="@(Helper.GetSessionData(Session)?.Usuario?.Imagen)" style="display:block;" />
                            }
                        </span>
                        <div class="info-card-text">
                            <div class="fs-lg text-truncate text-truncate-lg" data-bind="text:sessionData.Usuario.Nombre + ' ' + sessionData.Usuario.Apellido"></div>
                            <span class="text-truncate text-truncate-md opacity-80" data-bind="text:sessionData.Usuario.Mail"></span>
                        </div>
                    </div>
                </div>
                <div class="dropdown-divider m-0"></div>
                <a href="#" class="dropdown-item" data-toggle="modal" data-target=".js-modal-settings">
                    <i class="fal fa-share-alt mr-2"></i><span data-i18n="drpdwn.settings">Opciones De diseño</span>
                </a>
                <div class="dropdown-divider m-0"></div>
                <a class="dropdown-item d-none" data-bind="click: $root.buttonBloquear">
                    <i class="fal fa-lock-alt mr-2" mr-2"></i><span data-i18n="drpdwn.page-toblock">Bloquear</span>
                </a>
                <a class="dropdown-item fw-500 pt-3 pb-3" data-bind="click: $root.buttonLogout">
                    <i class="fal fa-sign-out-alt mr-2"></i><span data-i18n="drpdwn.page-logout">Cerrar sesión</span>
                </a>
            </div>
        </div>
    </div>
</header>
